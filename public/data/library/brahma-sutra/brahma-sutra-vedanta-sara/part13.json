  "commentary": {
    "commentary_id": "vedanta-sara",
    "commentary_title": "श्रीवेदान्तसारः",
    "commentator": {
      "devanagari": "भगवद् रामानुजः",
      "roman": "bhagavad rāmānujaḥ"
    },
    "passages": [
      {
        "ref": "4.1.1",
        "content": {
          "sanskrit": {
            "devanagari": "ब्रह्मविदाप्नोति परम् इत्यादिषु मोक्षसाधनं वेदनमसकृदावृत्तम्, विद्यात् , उपासीत इति विद्युपास्योरुपक्रमोपसंहारयोर्व्यतिकरेणोपदेशात्"
          }
        }
      },
      {
        "ref": "4.1.2",
        "content": {
          "sanskrit": {
            "devanagari": "लिङ्गं स्मृति:, मां ध्यायन्त उपासते , तेषामहं समुद्धर्ता मृत्युसंसार सागरात् , तद्रूपप्रत्यये चैका सन्ततिश्चान्यनिस्पृहा , तद्ध्यानं इत्यादिस्मृतेश्च"
          }
        }
      },
      {
        "ref": "4.1.3",
        "content": {
          "sanskrit": {
            "devanagari": "यद्यपि अधिकं तु भेदनिर्देशात् , अधिकोपदेशात् इत्यादिषु प्रत्यगात्मनोऽर्थान्तरत्वं ब्रह्मण: प्रतिपादितम्, तथाऽप्युपासिता अहं ब्रह्मास्मि इत्येवोपासीत, यत: पूर्वे उपासितार: त्वं वा अहमस्मि भगवो देवते अहं वै त्वमसि भगवो देवते इत्यात्मेत्येवोपगच्छन्ति। उपासितुरर्थान्तरमपि ब्रह्म तानुपासितॄन् स्वात्मभूतं ग्राहयन्ति शास्त्राणि य आत्मनि तिष्ठन्नात्मनोऽन्तरो यमात्मा न वेद यस्यात्मा शरीरं यमात्मानमन्तरो यमयति स त आत्माऽन्तर्याम्यमृत इत्यादीनि। यथा मनुष्योऽहमिति मनुष्यशरीरस्य स्वात्मप्रकारतैकस्वभावतया प्रकारिणि स्वात्मनि अहं शब्दस्य तद्बुद्धेश्च पर्यवसानम्, तथा स्वात्मनोऽपि परमात्मशरीरतया तत्प्रकारस्वभावत्वेन अहं शब्दतद्बुद्ध्यो: परमात्मनि पर्यवसानमिति अहं ब्रह्म इत्येवोपास्यमिति"
          }
        }
      },
      {
        "ref": "4.1.4",
        "content": {
          "sanskrit": {
            "devanagari": "मनो ब्रह्म इत्यादि प्रतीके तु नात्मेति ग्रहणम्। न हि तत्र स: - परमात्मोपास्य:, परमात्मदृष्ट्या हि मन: प्रभृतीति"
          }
        }
      },
      {
        "ref": "4.1.5",
        "content": {
          "sanskrit": {
            "devanagari": "ब्रह्मण उत्कृष्टत्वात्तद्दृष्ट्या मन आद्युपासनं ह्यभ्युदयाय भवतीति"
          }
        }
      },
      {
        "ref": "4.1.6",
        "content": {
          "sanskrit": {
            "devanagari": "य एवासौ तपति तमुद्गीथमुपासीत इत्यादावपि आदित्यादेरेवोत्कृष्टत्वात् उद्गीथादौ तद्दृष्टय: कार्या:"
          }
        }
      },
      {
        "ref": "4.1.7",
        "content": {
          "sanskrit": {
            "devanagari": "आसीन उपासनं कुर्यात्, तस्यैवैकाग्र्यसंभवात्"
          }
        }
      },
      {
        "ref": "4.1.8",
        "content": {
          "sanskrit": {
            "devanagari": "निदिध्यासितव्य इत्युपासनस्य ध्यानरूपत्वाच्चासीन:"
          }
        }
      },
      {
        "ref": "4.1.9",
        "content": {
          "sanskrit": {
            "devanagari": "पृथिव्यादेरचलत्वं चापेक्ष्य। ध्यायतीव पृथिवी इति प्रयोगात्। मनसो निश्चलत्वमासीनस्यैव"
          }
        }
      },
      {
        "ref": "4.1.10",
        "content": {
          "sanskrit": {
            "devanagari": "उपविश्यासने युञ्ज्यात् इत्यादिना"
          }
        }
      },
      {
        "ref": "4.1.11",
        "content": {
          "sanskrit": {
            "devanagari": "यत्रैकाग्रता तत्र देशे तत्र काले उपासीतेति, देशकालविशेषाश्रवणात्"
          }
        }
      },
      {
        "ref": "4.1.12",
        "content": {
          "sanskrit": {
            "devanagari": "अप्रयाणादहरहरुपासनं कार्यम्। स खल्वेवं वर्तयन्यावदायुषं इति दर्शनात्"
          }
        }
      },
      {
        "ref": "4.1.13",
        "content": {
          "sanskrit": {
            "devanagari": "उपासने प्रारब्धे तत्सामर्थ्यादेव पूर्वकृताघनाश:, उत्तराघाश्लेषश्च भवति। एवं हास्य सर्वे पाप्मान: प्रदूयन्ते, एवमेवं विदि पापं कर्म न श्लिष्यते इति श्रुते:"
          }
        }
      },
      {
        "ref": "4.1.14",
        "content": {
          "sanskrit": {
            "devanagari": "विदुष: पुण्यस्यापि मोक्षविरोधित्वेनानिष्टफलत्व- साम्यादेवमश्लेषविनाशौ, वृष्ट्यन्नायुरारोग्यादिविद्यानुगुणफलस्य कर्मण: शरीरपातादूर्ध्वं अफलत्वम्"
          }
        }
      },
      {
        "ref": "4.1.15",
        "content": {
          "sanskrit": {
            "devanagari": "विद्याधिगते: पूर्वकृते पुण्यपापे फलदानायाप्रवृत्ते एव विनश्यत:, तस्य तावदेव चिरं इति शरीरपातावधिश्रुते:"
          }
        }
      },
      {
        "ref": "4.1.16",
        "content": {
          "sanskrit": {
            "devanagari": "अग्निहोत्राद्याश्रमकर्म, विद्योत्पत्त्याख्यकार्यायैव आप्रयाणादनुष्ठेयम्। तमेतं वेदानुवचनेन ब्राह्मणा विविदिषन्ति इत्यादिना विद्योत्पत्तिकार्यत्वं ह्याश्रमधर्मस्य दृष्टम्"
          }
        }
      },
      {
        "ref": "4.1.17",
        "content": {
          "sanskrit": {
            "devanagari": "तस्य पुत्रा दायमुपयन्ति। द्विषन्त : पापकृत्यां सुहृदस्साधुकृत्याम् इत्यादिवचनस्याग्निहोत्रादेरन्याऽप्यनादिकालप्रवृत्ता साधुकृत्या प्रबलकर्मप्रतिबद्ध-फला, उत्तरा वृष्ट्यन्नादिविद्यानुगुणफला प्रतिबद्धा चेति पूर्वोत्तरकृतयोरुभयोरप्यस्त्येव विषय:"
          }
        }
      },
      {
        "ref": "4.1.18",
        "content": {
          "sanskrit": {
            "devanagari": "यदेव विद्यया इत्यत्र फलप्रतिबन्धोऽस्तीति ह्युक्तम्"
          }
        }
      },
      {
        "ref": "4.1.19",
        "content": {
          "sanskrit": {
            "devanagari": "आरब्धकार्ययो: पुण्यपापेयोर्यत्फलम्, तत् एकशरीरावसानमनेकशरीरावसानं वा भुक्त्वैव तदनन्तरं ब्रह्म प्राप्नोति\n\nइति श्रीभगवद्रामानुजविरचिते श्रीवेदान्तसारे चतुर्थस्याध्यायस्य प्रथम : पाद : ॥"
          }
        }
      }
    ]
  }
}