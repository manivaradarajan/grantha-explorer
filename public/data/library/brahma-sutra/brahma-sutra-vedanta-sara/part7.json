  "commentary": {
    "commentary_id": "vedanta-sara",
    "commentary_title": "श्रीवेदान्तसारः",
    "commentator": {
      "devanagari": "भगवद् रामानुजः",
      "roman": "bhagavad rāmānujaḥ"
    },
    "passages": [
      {
        "ref": "2.3.1",
        "content": {
          "sanskrit": {
            "devanagari": "वियन्नोत्पद्यते, अश्रुते:, श्रुति: - श्रवणम्। निरवयवस्य, आत्मन इवोत्पत्तिश्रवणासंभवात्"
          }
        }
      },
      {
        "ref": "2.3.2",
        "content": {
          "sanskrit": {
            "devanagari": "श्रवणं संभवत्येव, आकाशस्संभूत: इत्येव हि श्रुति: अतीन्द्रियार्थविषया वियदुत्पत्तिं प्रतिपादयति। आत्मनोऽपि न जायते इति प्रतिषेधादनुत्पत्ति:"
          }
        }
      },
      {
        "ref": "2.3.3",
        "content": {
          "sanskrit": {
            "devanagari": "तत्तेजोऽसृजत इति तेज: प्राथम्यवचनात् आकाशस्संभूत: इति श्रुतिर्गौणी वायुश्चान्तरिक्षं चैतदमृतम् इति शब्दाच्च"
          }
        }
      },
      {
        "ref": "2.3.4",
        "content": {
          "sanskrit": {
            "devanagari": "एकस्य संभूतशब्दस्याकाशे गौणत्वमन्यत्र मुख्यत्वम् अनुषङ्गे संभवत्येव, श्रवणावृत्तिवत्, यथैकस्य ब्रह्मशब्दस्य तस्मादेतद् ब्रह्म नामरूपमन्नं च जायते इति प्रकृतौ गौणत्वम्, तपसा चीयते ब्रह्म इति मुख्यत्वमावृत्तौ\n\nपरिहरति -"
          }
        }
      },
      {
        "ref": "2.3.5",
        "content": {
          "sanskrit": {
            "devanagari": "येनाश्रुतं श्रुतम् इत्यादिना एक विज्ञानेन सर्वविज्ञानप्रतिज्ञाया अहानि: वियदादेर्ब्रह्मकार्यत्वेन तदव्यतिरेकादेव॥५।"
          }
        }
      },
      {
        "ref": "2.3.6",
        "content": {
          "sanskrit": {
            "devanagari": "शब्देभ्य : - आकाशस्संभूत: इत्यादिशब्देभ्य: अवगतां वियदुत्पत्तिं तत्तेजोऽसृजत इत्यत्राकाशशब्दावचनावगतं तेज: प्राथम्यं न निवारयितुं क्षमम्"
          }
        }
      },
      {
        "ref": "2.3.7",
        "content": {
          "sanskrit": {
            "devanagari": "ऐतदात्म्यमिदं सर्वम् इत्यादिना आकाशादेरपि विकारत्वावगमात्, तेज: प्रभृतिविभागवचनं सर्वस्य प्रदर्शनार्थमिति निश्चीयते। यथा च लोके दशेमे देवदत्तपुत्रा इत्युक्त्वा तेषु केषाञ्चिदुत्पत्तिवचनम्"
          }
        }
      },
      {
        "ref": "2.3.8",
        "content": {
          "sanskrit": {
            "devanagari": "तेजोऽत: इत्यादि वक्तुं वायो: पृथगुपादानम्"
          }
        }
      },
      {
        "ref": "2.3.9",
        "content": {
          "sanskrit": {
            "devanagari": "असंभवस्तु परस्य ब्रह्मण एव। इतरस्य सदेवेत्यवधारणाद्यनुपपत्तेरुत्पत्तिरेव इति वियदधिकरणम् \n\nआकाशादिव्यवहितकार्याणामपि साक्षाद्ब्रह्मण उत्पत्तिं वक्तुं पूर्वपक्षमाह -"
          }
        }
      },
      {
        "ref": "2.3.10",
        "content": {
          "sanskrit": {
            "devanagari": "तेज: वायोरेवोत्पद्यते न साक्षाद्ब्रह्मण:, वायोरग्नि: इत्याह"
          }
        }
      },
      {
        "ref": "2.3.11",
        "content": {
          "sanskrit": {
            "devanagari": "अग्नेराप: इति श्रुते: आप: अग्ने:"
          }
        }
      },
      {
        "ref": "2.3.12",
        "content": {
          "sanskrit": {
            "devanagari": "पृथिवी अद्भ्य:। अद्भ्य: पृथिवी इति श्रुते:"
          }
        }
      },
      {
        "ref": "2.3.13",
        "content": {
          "sanskrit": {
            "devanagari": "ता अन्नमसृजन्त इत्यन्नशब्देन पृथिव्येवाभिधीयते, महाभूतसृष्ट्यधिकारात्। यत्कृष्णं तदन्नस्य इति पृथिवीरूपविधानात्, अद्भ्य: पृथिवी इति पृथिवीशब्दाभिधानच्च\n\nराद्धान्तमाह।"
          }
        }
      },
      {
        "ref": "2.3.14",
        "content": {
          "sanskrit": {
            "devanagari": "तत्तेज ऐक्षत, ता आप ऐक्षन्त इति तदभिध्यानरूपात्, तदैक्षत बहु स्याम् इत्येतत्सरूपात् परमात्मकारणत्वलिङ्गात् स एव परमात्मा तेज: प्रभृतिशरीरकस्तत्तच्छब्दैस्साक्षात्कारणत्वेनाभिधीयते"
          }
        }
      },
      {
        "ref": "2.3.15",
        "content": {
          "sanskrit": {
            "devanagari": "पारंपर्यक्रमात् विपर्ययेण एतस्माज्जायते प्राण: , खं वायुर्ज्योतिराप: इत्यादिवाक्यात् यस्साक्षाद्ब्रह्मणस्सृष्टेरुपक्रम:, सोऽपि अत: - तेज:- प्रभृतिशरीरकब्रह्मण एव सृष्टे: उपपद्यते"
          }
        }
      },
      {
        "ref": "2.3.16",
        "content": {
          "sanskrit": {
            "devanagari": "भूतप्राणयोरन्तराले इन्द्रियग्राममनसी क्रमेण उत्पद्येते इत्येतत्परमिदं वाक्यम्, खं वायुर्ज्योतिराप इत्यादि श्रुति प्रत्यभिज्ञानरूपाल्लिङ्गात्, अत इदमपि पारंपर्यक्रमपरमिति चेन्न, एतस्माज्जायते इत्यस्य प्राणादिपृथिव्यन्तेषु सर्वेषु प्रत्येकमन्वयाविशेषात्। अतस्तेज: प्रभृतीनामपि साक्षात्परमात्मैव कारणम्\n\nतत्तेज ऐक्षत इति तेज: प्रभृतिशब्दा: लोके तत्तद्वस्तुवाचिन: ब्रह्मणि भाक्ता इत्यत्राह -"
          }
        }
      },
      {
        "ref": "2.3.17",
        "content": {
          "sanskrit": {
            "devanagari": "चराचरवस्तु संबन्धितत्तद्वाचकशब्द: ब्रह्मणि अभाक्त: - मुख्यएव, अनेन जीवेनात्मनाऽनुप्रविश्य नामरूपे व्याकरवाणि इति तु सर्वस्य वस्तुनो नामरूपभाक्त्वस्य आत्मतया ब्रह्मानुप्रवेशभावभावित्वात्। लौकिकास्त्वेवमजानन्तो वाच्यैकदेशे प्रयुञ्जते"
          }
        }
      },
      {
        "ref": "2.3.18",
        "content": {
          "sanskrit": {
            "devanagari": "नात्मा उत्पद्यते, न जायते म्रियते इति श्रुते:, नित्यो नित्यानाम् इत्यादिश्रुतिभ्यो नित्यत्वावगतेश्च"
          }
        }
      },
      {
        "ref": "2.3.19",
        "content": {
          "sanskrit": {
            "devanagari": "अथ यो वेदेदं जिघ्राणीति स आत्मा, मनसैतान् कामान् पश्यन्रमते य एते ब्रह्मलोके इत्यादिश्रुते: बद्धो मुक्तश्चात्मा ज्ञातैव। मनोऽस्य दैवं चक्षु: इति श्रुते: स्वधर्मभूतं ज्ञानं मन:"
          }
        }
      },
      {
        "ref": "2.3.20",
        "content": {
          "sanskrit": {
            "devanagari": "उत्क्रान्तिगत्यागतीनां श्रुतेरणुर्जीव:"
          }
        }
      },
      {
        "ref": "2.3.21",
        "content": {
          "sanskrit": {
            "devanagari": "गत्यागत्योस्स्वात्मनैव संपाद्यत्वादप्यणुत्वं निश्चितम्"
          }
        }
      },
      {
        "ref": "2.3.22",
        "content": {
          "sanskrit": {
            "devanagari": "स वा एष महानज आत्मा इति श्रुते: नाणुरिति चेत्, न, यस्यानुवित्त: प्रतिबुद्ध आत्मा इति परमात्माधिकारात्"
          }
        }
      },
      {
        "ref": "2.3.23",
        "content": {
          "sanskrit": {
            "devanagari": "एषोऽणुरात्मा इत्यणुशब्दात् आराग्रमात्रो ह्यवर: इत्युद्धृत्य उन्मानशब्दाच्चाणु:\n\nअणोरपि सकलदेहव्यापिवेदनानुभवे अन्यमतेन हेतुमाह -"
          }
        }
      },
      {
        "ref": "2.3.24",
        "content": {
          "sanskrit": {
            "devanagari": "यथा चन्दनबिन्दुरेकदेशस्थोऽपि सकलदेहव्यापि सुखं जनयति, तद्वदविरोध:"
          }
        }
      },
      {
        "ref": "2.3.25",
        "content": {
          "sanskrit": {
            "devanagari": "देहदेशविशेषस्थितेश्चन्दनस्येति चेत्, न, आत्मनोऽपि तदभ्युपगमात्। हृदि ह्ययमात्मा, योऽयं विज्ञानमय: प्राणेषु हृद्यन्तर्ज्योति: इति श्रुते: स्वमतेनाह -"
          }
        }
      },
      {
        "ref": "2.3.26",
        "content": {
          "sanskrit": {
            "devanagari": "आत्मा स्वगुणेन ज्ञानेन सकलदेहं व्याप्यानुभवति, यथा मणिप्रभृतयस्स्वकीयेनालोकेन सकलदेशं व्याप्य प्रकाशयन्ति, प्रज्ञामात्रास्वर्पिता इति श्रुते:\n\nन ज्ञानात्मनो: व्यतिरेक इत्यत्राह -"
          }
        }
      },
      {
        "ref": "2.3.27",
        "content": {
          "sanskrit": {
            "devanagari": "गन्धवती पृथिवी इतिवत्, अहं जानामि इति गुणवत्त्वेनोपलब्धे: व्यतिरेकोऽस्ति। दर्शयति च श्रुतिर्व्यतिरेकम् जानात्येवायं पुरुष इति"
          }
        }
      },
      {
        "ref": "2.3.28",
        "content": {
          "sanskrit": {
            "devanagari": "आत्मन: पृथक्त्वेन चोपदिश्यते न हि विज्ञातुर्विज्ञातेर्विपरिलोपो विद्यते इति\n\nयोऽयं विज्ञानमय इति ज्ञानमात्रव्यपदेश: कथमित्यत्राह -"
          }
        }
      },
      {
        "ref": "2.3.29",
        "content": {
          "sanskrit": {
            "devanagari": "ज्ञानगुणसारत्वादात्मनो ज्ञानमिति व्यपदेश:, यथा प्राज्ञस्य विपश्चितोऽपि सत्यं ज्ञानम् इति"
          }
        }
      },
      {
        "ref": "2.3.30",
        "content": {
          "sanskrit": {
            "devanagari": "आत्मस्वरूपानुबन्धित्वात् ज्ञानस्य तेन व्यपदेशे न दोष:। स्वरूपानुबन्धिधर्मत्वेन गोत्वादीनां खण्डादे: गौरित्यादिव्यपदेशो हि दृश्यते\n\nसुषुप्त्यादिष्वसतो ज्ञानस्य यावदात्मभावित्वं कथमित्यत्राह -"
          }
        }
      },
      {
        "ref": "2.3.31",
        "content": {
          "sanskrit": {
            "devanagari": "सुषुप्त्यादिषु सतो ज्ञानस्यानभिव्यक्तस्यापि जागरादावभिव्यक्तिसंभवात्। स्वरूपानुबन्ध्येव ज्ञानम्। यथा पुंस्त्वासाधरणसप्तमधातोर्बाल्येऽपि सतो युवत्वेऽभिव्यक्ति:। जीवात्मनो ज्ञातृत्वमणुत्वं चोक्तम्"
          }
        }
      },
      {
        "ref": "2.3.32",
        "content": {
          "sanskrit": {
            "devanagari": "अन्यथा ज्ञप्तिमात्रसर्वगतात्मवादे तावन्नित्यवत् सर्वदोपलब्धिस्स्यात्, संकोचकाभावाद्विद्यमानाया अनुपलब्धेरपि सैव हेतुरिति साऽपि नित्यवत्स्यात्, ज्ञाने विद्यमानेऽपि हेत्वन्तरेण निवारणासंभवात्। आगन्तुकज्ञानसर्वगतात्मवादेऽपि स एव दोष:, सर्वात्मनां सर्वगतत्वेन ज्ञानहेतूनां मनस्संयोगादीनां सर्वसाधारणत्वात्। अदृष्टहेतूनामपि सर्वसाधारणत्वात् तेनापि न नियम:। अथोपलब्ध्यनुपलब्ध्योर्विरोधादुपलब्धेरेवैते हेतव: स्यु:, अनुपलब्धेर्वा, तथा सत्यन्यतरनियमस्स्यात्"
          }
        }
      },
      {
        "ref": "2.3.33",
        "content": {
          "sanskrit": {
            "devanagari": "ज्ञाता सन्नयमात्मा कर्मसु कर्ता च। आत्मन: अकर्तृत्वे, कुर्यात्, न कुर्यादिति शास्त्रानर्थक्यं स्यात्"
          }
        }
      },
      {
        "ref": "2.3.34",
        "content": {
          "sanskrit": {
            "devanagari": "प्राणान् गृहीत्वा स्वे शरीरे यथाकामं परिवर्तते इत्युपादानविहारोपदेशाच्च कर्ता"
          }
        }
      },
      {
        "ref": "2.3.35",
        "content": {
          "sanskrit": {
            "devanagari": "विज्ञानं यज्ञं तनुते इत्यादिना यज्ञादौ कर्तृत्वव्यपदेशाच्च कर्ता। विज्ञानशब्दो बुद्धे:, नात्मन: इति चेत्, न, तदा विज्ञानेनेति निर्देशविपर्यय: स्यात्, बुद्धे: करणत्वात्"
          }
        }
      },
      {
        "ref": "2.3.36",
        "content": {
          "sanskrit": {
            "devanagari": "प्रकृतेरेव कर्तृत्वे तस्यास्सर्वसाधारणत्वेन पूर्वोपलब्ध्यनियमवत् फलानियमस्स्यात्"
          }
        }
      },
      {
        "ref": "2.3.37",
        "content": {
          "sanskrit": {
            "devanagari": "प्रकृतेरेव कर्तृत्वे कर्तुरेव भोक्तृत्वमिति सैव भोक्त्री स्यादित्यर्थ:"
          }
        }
      },
      {
        "ref": "2.3.38",
        "content": {
          "sanskrit": {
            "devanagari": "प्रकृतेरेव कर्तृत्वे प्रकृतेरन्योऽस्मीति समाध्यभावप्रसङ्गाच्च"
          }
        }
      },
      {
        "ref": "2.3.39",
        "content": {
          "sanskrit": {
            "devanagari": "आत्मन: कर्तृत्वे, इच्छायां करोति, अन्यथा न करोतीति व्यवस्था च सिध्यति। यथा तक्षा स्वकार्येषु। बुद्धेरिच्छाभावात् न व्यवस्था। चेतनधर्मत्वादिच्छाया:"
          }
        }
      },
      {
        "ref": "2.3.40",
        "content": {
          "sanskrit": {
            "devanagari": "य आत्मानमन्तरो यमयति इत्यादि श्रुतेरात्मन: कर्तृत्वं परायत्तम्, सर्वस्य चाहं हृदि सन्निविष्टो मत्त: स्मृतिर्ज्ञानमपोहनं च इत्यादिस्मृतेश्च"
          }
        }
      },
      {
        "ref": "2.3.41",
        "content": {
          "sanskrit": {
            "devanagari": "जीव: स्वेच्छया प्रवृत्तिनिवृत्ति- हेतुभूतं प्रयत्नं करोति, जीवेन तु कृतं प्रयत्नं प्रथमप्रवृत्तिहेतुमपेक्ष्य तदनुमतिदानेन पर: प्रवर्तयति - इति तद्विधिनिषेधावैयर्थ्यनिग्रहानुग्रहेभ्योऽवगम्यते। यथा गुरुतरदार्वातिभरणमबल: प्रबलसहकृत: कुर्वन्नपि स्वीयप्रयत्नेन विधिनिषेधयोग्यो भवति, एवमेव जीव: परमपुरुषानुमतिसहकृत: प्रवर्तमानोऽपि विधिनिषेधयोग्य इति न कश्चिद्विरोध:"
          }
        }
      },
      {
        "ref": "2.3.42",
        "content": {
          "sanskrit": {
            "devanagari": "जीवात्मा परमपुरुषांश:। पृथगात्मनं प्रेरितारं च मत्वा, स कारणं करणाधिपाधिप: इत्यादिनाव्यपदेशात्, अन्यथा, तत्त्वमसि, अयमात्मा ब्रह्म इति ऐक्योपदेशाच्च । ब्रह्मदाशा: इत्यादिना सर्वजीवव्याप्त्या ऐक्यमधीयत एके, अंशत्वाभ्युपगमे ह्युभयं मुख्यं भवति"
          }
        }
      },
      {
        "ref": "2.3.43",
        "content": {
          "sanskrit": {
            "devanagari": "पादोऽस्य विश्वा भूतानि इति मन्त्रावर्णाच्च"
          }
        }
      },
      {
        "ref": "2.3.44",
        "content": {
          "sanskrit": {
            "devanagari": "ममैवांशो जीवलोके जीवभूतस्सनातन: इत्यादिना"
          }
        }
      },
      {
        "ref": "2.3.45",
        "content": {
          "sanskrit": {
            "devanagari": "ब्रह्मांशत्वेऽपि जीवस्य, जीवो यत्स्वरूपो यत्स्वभावश्च, नैवं पर: - निरवद्य: सर्वज्ञ: सत्यसंकल्प एव सर्वदा। कथम्? प्रकाशादिवत् प्रकाशविशिष्टानां मणिप्रभृतीनां प्रकाश: विशिष्टैकदेशत्वेन यथांश:। आदिशब्दाद्विशेषणतैकस्वभावजातिगुणशरीराणि गृह्यन्ते। विशेषणानां विशिष्टैकदेशतया तदंशत्वेऽपि विशेषणविशेष्ययो: स्वरूपस्वभावभेदो न विरुद्ध:। य आत्मनि तिष्ठन्यस्यात्मा शरीरम् इति हि श्रुति:"
          }
        }
      },
      {
        "ref": "2.3.46",
        "content": {
          "sanskrit": {
            "devanagari": "चिदचिदात्मकजगतो ब्रह्मांशत्वं प्रकाशादिवदिति पराशरादय: स्मरन्ति।\n\nएक देशस्थितस्याग्ने : ज्योत्स्ना विस्तारिणी यथा ।\n\nपरस्य ब्रह्मणश्शक्तिस्तथेदमखिलं जगत् ॥\n\nतत्सर्वं वै हरेस्तनु :, तानि सर्वाणि तद्वपु : इत्यादिषु"
          }
        }
      },
      {
        "ref": "2.3.47",
        "content": {
          "sanskrit": {
            "devanagari": "ब्रह्मांशत्वेऽपि सर्वजीवानां कस्य चिद्वेदाध्ययनादौ अनुज्ञा कस्य चित्परिहार: इत्येतौ ब्राह्मणादिदेहविशेषसंबन्धादुपपद्येते। यथाऽग्न्यादे: श्रोत्रियागारश्मशानादिसंबन्धात्"
          }
        }
      },
      {
        "ref": "2.3.48",
        "content": {
          "sanskrit": {
            "devanagari": "प्रतिदेहं भिन्नत्वात् अणुत्वेन तत्र तत्र परिच्छिन्नत्वाच्च ज्ञानसुखाद्यव्यतिकर:। अज्ञानोपाधिभ्यां ब्रह्मैव संबध्यते इति पक्षद्वयेऽपि न तत्तद्व्यवस्था"
          }
        }
      },
