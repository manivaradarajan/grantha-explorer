  "commentary": {
    "commentary_id": "vedanta-sara",
    "commentary_title": "श्रीवेदान्तसारः",
    "commentator": {
      "devanagari": "भगवद् रामानुजः",
      "roman": "bhagavad rāmānujaḥ"
    },
    "passages": [
      {
        "ref": "3.4.1",
        "content": {
          "sanskrit": {
            "devanagari": "विद्यात: पुरुषार्थ: इति भगवान् बादरायणो मेने, ब्रह्मविदाप्नोति परम् , यो वेद ….सोऽश्नुते सर्वान् कामान् सह इत्यादिशब्दात्"
          }
        }
      },
      {
        "ref": "3.4.2",
        "content": {
          "sanskrit": {
            "devanagari": "तत्त्वमसि इत्यादि सामानाधिकरण्येन कर्मसु कर्तुरेव ब्रह्मत्वावगमात्, तद्वेदनस्य तत्संस्कारतया कर्मशेषत्वात्, द्रव्यादिष्विव फलश्रुतिरर्थवाद:"
          }
        }
      },
      {
        "ref": "3.4.3",
        "content": {
          "sanskrit": {
            "devanagari": "यक्ष्यमाणो ह वै भगवन्तोऽहमस्मि इत्यादौ ब्रह्मविद: कर्मप्रधानाचार दर्शनात् विद्या कर्माङ्गम्"
          }
        }
      },
      {
        "ref": "3.4.4",
        "content": {
          "sanskrit": {
            "devanagari": "यदेव विद्यया करोति इति श्रुत्यैव विद्याया: कर्मसु विनियोगात्। यत्करोति तद्विद्यया इति हि श्रुति:। यद्विद्यया साधनभूतया कर्म करोति, तत्कर्म वीर्यवत्तरमिति वा"
          }
        }
      },
      {
        "ref": "3.4.5",
        "content": {
          "sanskrit": {
            "devanagari": "तं विद्याकर्मणी समन्वारभेते इति विद्याकर्मणोरेकस्मिन्पुरुषे साहित्यदर्शनाच्च, विद्याकर्माङ्गम्"
          }
        }
      },
      {
        "ref": "3.4.6",
        "content": {
          "sanskrit": {
            "devanagari": "आचार्यकुलाद्वेदमधीत्य अभिसमावृत्य कुटुम्बे इत्यादावर्थज्ञान-पर्यन्ताध्ययनवत: कर्मविधानाच्च; अध्ययनं ह्यर्थज्ञानपर्यन्तम्"
          }
        }
      },
      {
        "ref": "3.4.7",
        "content": {
          "sanskrit": {
            "devanagari": "कुर्वन्नेवेह कर्माणि जिजीविषेच्छतं समा : इत्यात्मविदो जीवस्य कर्मसु विनियोगाच्च"
          }
        }
      },
      {
        "ref": "3.4.8",
        "content": {
          "sanskrit": {
            "devanagari": "न विद्या कर्माङ्गम्, अपि तु विद्यात: पुरुषार्थ इत्येवमेव भगवतो बादरायणस्य मतम्; कर्तु: प्रत्यगात्मनोऽर्थान्तरभूतस्यैव वेद्यतयोपदेशात्। तत्कथम्? बहु स्यां प्रजायेयेति ॥ स कारणं करणाधिपाधिप : इत्यादिवाक्येषु वेद्यस्याधिकत्वदर्शनात्"
          }
        }
      },
      {
        "ref": "3.4.9",
        "content": {
          "sanskrit": {
            "devanagari": "विद्याया: प्राधान्येऽपि तुल्यमाचारदर्शनम्। ऋषय : कावषेया : किमर्था वयमध्येष्यामह इत्यादौ ब्रह्मविदां कर्मत्यागो हि दृश्यते। अनुष्ठानं तु फलाभिसन्धिरहितस्य विद्याङ्गत्वेन; त्यागस्तु फलाभिसन्धियुक्तस्येति न विरोध:"
          }
        }
      },
      {
        "ref": "3.4.10",
        "content": {
          "sanskrit": {
            "devanagari": "यदेव विद्यया करोति इति न सार्वत्रिकी विद्योच्यते, यदेव विद्यया इति प्रसिद्धवन्निर्देशात्। प्रसिद्धिश्चोद्गीथविद्याया:। यदेव विद्यया करोति, तदेव वीर्यवत्तरम् भवति इति प्रकृतोद्गीथविद्यायुक्तस्य कर्मणो हि वीर्यवत्तरत्वसाधनभावो विधीयते"
          }
        }
      },
      {
        "ref": "3.4.11",
        "content": {
          "sanskrit": {
            "devanagari": "तं विद्याकर्मणी समन्वारभेते इति विद्याकर्मणोर्भिन्नफलत्वेन स्वस्मै फलायान्वेतीति विभाग:। यथा क्षेत्ररत्नविक्रयिणे शतद्वयमन्वेतीत्यत्र, क्षेत्रार्थं शतम्, रत्नार्थं शतमिति"
          }
        }
      },
      {
        "ref": "3.4.12",
        "content": {
          "sanskrit": {
            "devanagari": "वेदमधीत्य इत्यध्ययनमात्रवत: कर्मविधानात् न विद्याकर्माङ्गम्। अध्ययनविधिर्हि अक्षरराशिग्रहणमात्रे पर्यवस्यतीत्युक्तम्। अर्थावबोधपर्यन्तत्वेऽप्यर्थज्ञानात् अर्थान्तरभूता विद्यात्, उपासीत इति विहिता विद्या प्रत्ययावृत्तिरूपा"
          }
        }
      },
      {
        "ref": "3.4.13",
        "content": {
          "sanskrit": {
            "devanagari": "कुर्वन्नेवेह कर्माणि इत्यत्र स्वतन्त्रे कर्मणि विद्वदायुषो विनियोग इति विशेषहेत्वभावात्। ईशावास्यमिदं सर्वम् इति प्रकरणाच्च विद्याङ्गभूतमेव च तत्कर्मेति ज्ञायते। अतो न विद्या कर्माङ्गम्"
          }
        }
      },
      {
        "ref": "3.4.14",
        "content": {
          "sanskrit": {
            "devanagari": "विद्यास्तुतये कर्मानुमतिर्वा। विद्यामाहात्म्यात्सर्वदा कर्म कुर्वन्नपि तैर्न लिप्यत इति हि विद्या स्तुता स्यात्। न कर्म लिप्यते नरे इति च वाक्यशेष:"
          }
        }
      },
      {
        "ref": "3.4.15",
        "content": {
          "sanskrit": {
            "devanagari": "किं प्रजया करिष्याम इत्यादिना कामकारेण गार्हास्थ्यत्यागमधीयत एके। अतश्च विद्यैव प्रधानभूता"
          }
        }
      },
      {
        "ref": "3.4.16",
        "content": {
          "sanskrit": {
            "devanagari": "विद्यया सर्वकर्मोपमर्दं चाधीयते। क्षीयन्ते चास्य कर्माणि तस्मिन्दृष्टे परावरे इत्यादिना"
          }
        }
      },
      {
        "ref": "3.4.17",
        "content": {
          "sanskrit": {
            "devanagari": "ऊर्ध्वरेतस्स्वाश्रमेषु ब्रह्मविद्यादर्शनात्, तेषु चाग्निहोत्राद्यभावान्न विद्या कर्माङ्गम्। ते चाश्रमास्सन्त्येव; त्रयो धर्मस्कन्धा: इति वैदिक शब्दे हि दृश्यते"
          }
        }
      },
      {
        "ref": "3.4.18",
        "content": {
          "sanskrit": {
            "devanagari": "त्रयो धर्मस्कन्धा: इत्यत्र चोदनाभावादुपासना- स्तुत्यर्थमनुवादमेव जैमिनिर्मेने। वीरहा वा एष देवानां योऽग्निमुद्वासयत इत्यपवदति चाश्रमान्तरम्"
          }
        }
      },
      {
        "ref": "3.4.19",
        "content": {
          "sanskrit": {
            "devanagari": "गृहस्थाश्रमवदाश्रमान्तरमप्यनुष्ठेयमिति बादरायणमतम्, त्रयो धर्मस्कन्धा: इति सर्वाश्रमसाम्यश्रुते:"
          }
        }
      },
      {
        "ref": "3.4.20",
        "content": {
          "sanskrit": {
            "devanagari": "उपरि हि देवेभ्यो धारयति इत्यप्राप्तत्वेन यथा विधि:, तद्वत्"
          }
        }
      },
      {
        "ref": "3.4.21",
        "content": {
          "sanskrit": {
            "devanagari": "उद्गीथादिषु रसमतत्वादिदृष्टिविधिर्न संभवति, इयमेव जुहूस्स्वर्गो लोक आहवनीय: इतिवत्, कर्माङ्गभूतोद्गीथाद्युपादाय तस्य रसतमत्ववचनं तत्स्तुतिमात्रमिति चेत्, नैतत्। जुह्वादिविधिवदुद्गीथादिविधेरत्रासन्निधानात्। रसतमत्वादेश्चाप्राप्तत्वाद्रसतमत्वादि- दृष्टिविधिरेव"
          }
        }
      },
      {
        "ref": "3.4.22",
        "content": {
          "sanskrit": {
            "devanagari": "उद्गीथमुपासीत इति विधिप्रत्ययाच्च"
          }
        }
      },
      {
        "ref": "3.4.23",
        "content": {
          "sanskrit": {
            "devanagari": "वेदान्तेषु तत्तद्विद्यारम्भेऽधीता: प्रतर्दनो ह वै इत्याद्याख्यायिका: पारिप्लवार्था:, आख्यानानि शंसन्ति इति तत्र विनियोगादिति चेत्, न, तत्रैव मनुर्वैवस्वत इत्याद्याख्यानानां विशेषितत्वात्तेषामेव तत्र विनियोग:"
          }
        }
      },
      {
        "ref": "3.4.24",
        "content": {
          "sanskrit": {
            "devanagari": "विद्याविधिनैकवाक्यत्वाच्च। सोऽरोदीत् इत्यादिवत् विद्यास्तुत्यर्था एता:"
          }
        }
      },
      {
        "ref": "3.4.25",
        "content": {
          "sanskrit": {
            "devanagari": "ऊर्ध्वरेतसाम् एतमेव प्रव्राजिनो लोकमिच्छन्त: प्रव्रजन्ति इत्यादिश्रुतेरेव विद्यावत्त्वात् तेष्वाधानाद्यनपेक्षा विद्या"
          }
        }
      },
      {
        "ref": "3.4.26",
        "content": {
          "sanskrit": {
            "devanagari": "कर्मवत्सु गृहस्थेष्वग्निहोत्रादिसर्वकर्मापेक्षा विद्या। ब्राह्मणा विविदिषन्ति,यज्ञेन दानेन तपसाऽनाशकेन इत्यादिश्रुते:। यथा चाश्वो गमनसाधनभूतोऽपि स्वपरिकरबन्धापेक्षो गमने। ऊर्ध्वरेतस्सु च स्वाश्रमकर्मापेक्षा"
          }
        }
      },
      {
        "ref": "3.4.27",
        "content": {
          "sanskrit": {
            "devanagari": "गृहस्थो विहितकर्मव्यापृतोऽपि शान्तो दान्त : इत्यादिना शमदमादिविधेस्तद्युक्तस्स्यात्, विद्यानिष्पत्तये शमदमादीनामवश्यानुष्ठेयत्वात्, शान्त्युपरतिप्रभृतिभिर्विना विद्यानिष्पत्त्य-नुपपत्ते:"
          }
        }
      },
      {
        "ref": "3.4.28",
        "content": {
          "sanskrit": {
            "devanagari": "प्राणविद्यानिष्ठस्य न ह वा एवं विदि किञ्चन नानन्नं भवति इति सर्वान्नानुमतिर्न सर्वदा, अपि तु प्राणात्ययापत्तावेव। अतिशयितशक्तेर्ब्रह्मविदोऽप्युच्छिष्टभक्षणादि: प्राणात्ययापत्तावेवेति दर्शनात्"
          }
        }
      },
      {
        "ref": "3.4.29",
        "content": {
          "sanskrit": {
            "devanagari": "आहारशुद्धौ सत्त्वशुद्धिस्सत्त्वशुद्धौ ध्रुवा स्मृति : इत्याहारशुद्धि- विधेरबाधाच्च प्राणसंशय एव"
          }
        }
      },
      {
        "ref": "3.4.30",
        "content": {
          "sanskrit": {
            "devanagari": "प्राणसंशयमापन्नो योऽन्नमत्ति यतस्तत: , इत्यादिना स्मर्यते च प्राणसंशय एवेति"
          }
        }
      },
      {
        "ref": "3.4.31",
        "content": {
          "sanskrit": {
            "devanagari": "तस्माद्ब्राह्मणस्सुरां न पिबति इति कामकारनिवृत्तिशब्दश्चात एव। यत: प्राणसंशय एव सर्वान्नानुमति:"
          }
        }
      },
      {
        "ref": "3.4.32",
        "content": {
          "sanskrit": {
            "devanagari": "यज्ञादिकर्म यावज्जीवमग्निहोत्रं जुहुयात् इत्यादिना विहितत्वात् विद्यारहितकेवलाश्रमिणामप्यनुष्ठेयम्"
          }
        }
      },
      {
        "ref": "3.4.33",
        "content": {
          "sanskrit": {
            "devanagari": "तमेतं वेदानुवचनेन इत्यादि श्रुतेर्विद्याङ्गतया विधेर्विद्या सहकारित्वेन विदुषा चानुष्ठेयम्"
          }
        }
      },
      {
        "ref": "3.4.34",
        "content": {
          "sanskrit": {
            "devanagari": "उभयत्र विनियोगेऽपि यज्ञादयस्त एव, उभयत्र प्रत्यभिज्ञानाख्याल्लिङ्गात्। कर्मस्वरूपैक्येऽपि विनियोगपृथक्त्वेन न विरोध:"
          }
        }
      },
      {
        "ref": "3.4.35",
        "content": {
          "sanskrit": {
            "devanagari": "धर्मेण पापमपनुदति इति विद्योत्पत्तिप्रतिबन्धक- पापनिवर्तनेन विद्याया अनभिभवं कर्मानुष्ठानकार्यं च दर्शयति"
          }
        }
      },
      {
        "ref": "3.4.36",
        "content": {
          "sanskrit": {
            "devanagari": "आश्रमानन्तरा वर्तमानो विधुरादिरनाश्रमी। तस्यापि विद्याधिकारोऽस्ति, रैक्वादिष्वनाश्रमिषु ब्रह्मविद्याधिकारदर्शनात्"
          }
        }
      },
      {
        "ref": "3.4.37",
        "content": {
          "sanskrit": {
            "devanagari": "अनाश्रमिणोऽपि जपादिना विद्यानुग्रह: स्मर्यते। जप्येनापि च संसिध्येत् इति"
          }
        }
      },
      {
        "ref": "3.4.38",
        "content": {
          "sanskrit": {
            "devanagari": "आश्रमानियतधर्मविशेषेण विद्यानुग्रहश्च श्रूयते। तपसा ब्रह्मचर्येण श्रद्धया विद्यया चाऽऽत्मानमन्विच्छेत् इत्यादिना"
          }
        }
      },
      {
        "ref": "3.4.39",
        "content": {
          "sanskrit": {
            "devanagari": "अनाश्रमित्वादाश्रमित्वं ज्याय:, धर्मभूयस्त्वात्, अनाश्रमी न तिष्ठेत्तु इति स्मृतेश्च"
          }
        }
      },
      {
        "ref": "3.4.40",
        "content": {
          "sanskrit": {
            "devanagari": "नैष्ठिकादिनिष्ठस्य प्रच्युत्य स्थितिर्न संभवत्येव, नियमात्, तद्रूपनिवृत्तिभ्य:। यथा नियच्छन्ति हि अत्यन्तमात्मान- माचार्यकुलेऽवसादयन् इति। अरण्यमियात्ततो न पुनरेयात् इति च। संन्यस्याग्निं न पुनरावर्तयेत् इति च। अतस्तेषां प्रच्युत्य स्थित्यभावाद्विद्यानधिकार: जैमिनेरप्येवम्"
          }
        }
      },
      {
        "ref": "3.4.41",
        "content": {
          "sanskrit": {
            "devanagari": "अवकीर्णिपशुश्च तद्वत् इत्यधिकारलक्षणोक्तं प्रायश्चित्तमपि तस्य न संभवति, तस्य प्रायश्चित्तानाधिकारस्मृते: तदसंभवात्। आरूढो नैष्ठिकं धर्मं इत्यारभ्य प्रायश्चित्तं न पश्यामि इत्यादिस्मृते:"
          }
        }
      },
      {
        "ref": "3.4.42",
        "content": {
          "sanskrit": {
            "devanagari": "उपपातकत्वात् प्रायश्चित्तमेके मध्वशननिषेध- तत्प्रायश्चित्तवदिति। तदुक्तं उत्तरेषां चैतदविरोधि इति"
          }
        }
      },
      {
        "ref": "3.4.43",
        "content": {
          "sanskrit": {
            "devanagari": "उपपातकत्वेऽपि अन्यथाऽपि कर्माधिकारबहिष्कृता एते, तथा स्मृते:। प्रायश्चितं न पश्यामि येन शुद्ध्येत्स आत्महा इति, शिष्टबहिष्काराच्च"
          }
        }
      },
      {
        "ref": "3.4.44",
        "content": {
          "sanskrit": {
            "devanagari": "उद्गीथाद्युपासनं यजमानेनानुष्ठेयम्, तस्यैव क्रतुवीर्यवत्तरत्वादिफलश्रुतेरित्यात्रेय:"
          }
        }
      },
      {
        "ref": "3.4.45",
        "content": {
          "sanskrit": {
            "devanagari": "कर्मस्वरूपवत्तदङ्गाश्रयमप्यार्त्विज्यम्। साङ्गफलसाधनकर्मानुष्ठानाय हि ऋत्विक्परिक्रियते"
          }
        }
      },
      {
        "ref": "3.4.46",
        "content": {
          "sanskrit": {
            "devanagari": "तस्माद्ब्राह्मण : पाण्डित्यं निर्विद्य इत्यारभ्य अथ मुनि: इत्यत्र विद्यावतो यज्ञादिवत् बाल्यपाण्डित्ययोस्तृतीयं सहकार्यन्तरं मौनं विधीयते, पक्षेण प्रकृष्टमननशीले मुनिशब्दप्रयोगात्। विद्याभ्यासरूपमननमिदं अप्राप्तमेव"
          }
        }
      },
      {
        "ref": "3.4.47",
        "content": {
          "sanskrit": {
            "devanagari": "कृत्स्नेष्वाश्रमिषु विद्यासद्भावात् । छान्दोग्ये अभिसमावृत्य कुटुम्बे इत्यारभ्य स खल्वेवं वर्तयन्यावदायुषं इति ब्रह्मलोकमभिसंपद्यते इति गृहिणोपसंहारस्सर्वेषां प्रदर्शनार्थ:। तु शब्दो हि गृहिण एवेति शङ्काव्यावृत्यर्थ:"
          }
        }
      },
      {
        "ref": "3.4.48",
        "content": {
          "sanskrit": {
            "devanagari": "अथ मुनि : इत्यत्रापि अथ भिक्षाचर्यं चरति इति पारिव्राज्येनोपसंहार: प्रदर्शनार्थ:, मौनभिक्षाचर्यवदितराश्रमधर्माणां यज्ञादीनामप्युपदेशात्"
          }
        }
      },
      {
        "ref": "3.4.49",
        "content": {
          "sanskrit": {
            "devanagari": "पाण्डित्यं निर्विद्य बाल्येन तिष्ठासेत् इति बाल्यमित्यविशेषेण श्रुतावपि बालकर्मस्वमाहात्म्यानाविष्काररूपं विद्यान्वययोग्यतया विधीयते"
          }
        }
      },
      {
        "ref": "3.4.50",
        "content": {
          "sanskrit": {
            "devanagari": "अभ्युदयफलमुपासनं स्वसाधनभूतपुण्य-कर्मानन्तरमुत्पद्यत इति नायं नियम:। प्रबलकर्मान्तरप्रतिबन्धाभावे तदनन्तरम्, प्रतिबन्धे तु तस्मिन् समाप्ते। तदेव वीर्यवत्तरम् इति प्रतिबन्धाभावे फलदर्शनात्"
          }
        }
      },
      {
        "ref": "3.4.51",
        "content": {
          "sanskrit": {
            "devanagari": "एवं मुक्तिफलोपासनस्यापि प्रतिबन्धभावाभावयोरित्यनियम:, प्रतिबन्धाभाव एवेति फलोदयावस्थावधृते:\n\nइति श्रीभगवद्रामानुजविरचिते श्रीवेदान्तसारे तृतीयस्याध्यायस्य चतुर्थ पाद :॥\n\n॥ समाप्तश्चाध्याय :॥"
          }
        }
      }
    ]
  }
}