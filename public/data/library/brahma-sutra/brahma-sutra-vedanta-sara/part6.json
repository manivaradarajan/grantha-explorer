  "commentary": {
    "commentary_id": "vedanta-sara",
    "commentary_title": "श्रीवेदान्तसारः",
    "commentator": {
      "devanagari": "भगवद् रामानुजः",
      "roman": "bhagavad rāmānujaḥ"
    },
    "passages": [
      {
        "ref": "2.2.1",
        "content": {
          "sanskrit": {
            "devanagari": "दार्वादेरचेतनस्य रथप्रासादादिनिर्माणे तदभिज्ञानधिष्ठितस्य रचनानुपपत्तेश्च तज्ज्ञाधिष्ठितस्य रचनाप्रवृत्तेश्च अनुमानगम्यं प्रधानमचेतनं प्राज्ञानधिष्ठितं न जगत्कारणम्"
          }
        }
      },
      {
        "ref": "2.2.2",
        "content": {
          "sanskrit": {
            "devanagari": "यथा पय: अम्बु च दध्यादिभावेऽनपेक्षं, तद्वत्प्रधानमपीतिचेत्, तत्राप्युक्त एव हेतु:, तस्यापि पक्षीकृतत्वात्"
          }
        }
      },
      {
        "ref": "2.2.3",
        "content": {
          "sanskrit": {
            "devanagari": "प्राज्ञाधिष्ठितत्वानपेक्षत्वेन सर्वदा सृष्टिप्रसङ्गाच्च न प्रधानं कारणम्"
          }
        }
      },
      {
        "ref": "2.2.4",
        "content": {
          "sanskrit": {
            "devanagari": "क्षीरीभवद्धेनूपयुक्ततृणादिवत् प्रधानमपीति न युक्तं वक्तुम्, अनडुहा(दा)दिष्वदर्शनात्, तद्धि प्राज्ञाधिष्ठितम्"
          }
        },
        "references": [
          {
            "start": 67,
            "end": 69,
            "display_text": "दा",
            "grantha_id": null,
            "edition_id": null,
            "locator": null,
            "locator_end": null,
            "group_id": null,
            "unresolved": true
          }
        ]
      },
      {
        "ref": "2.2.5",
        "content": {
          "sanskrit": {
            "devanagari": "पुरुष: स्वसन्निधानात्प्रधानं प्रवर्तयति अन्धपङ्गु पुरुषवत्, अश्मवत् - अयस्कान्ताश्मवदिति न प्राज्ञापेक्षेति चेत्, न, तथाऽपि न प्रधानप्रवृत्ति- संभव:, अविकृतत्वात्पुरुषस्य, पङ्ग्वन्धादे: मार्गोपदेशदेशान्तरगमनादि: कादाचित्को विकारोऽस्ति"
          }
        }
      },
      {
        "ref": "2.2.6",
        "content": {
          "sanskrit": {
            "devanagari": "गुणानामुत्कर्षापकर्षरूपाङ्गाङ्गिभावाद्धि जगत्प्रवृत्ति:, प्रतिसर्गावस्थायां साम्यावस्थानां वैषम्यकृताङ्गाङ्गित्वानुपपत्तेश्च न जगदारम्भ:"
          }
        }
      },
      {
        "ref": "2.2.7",
        "content": {
          "sanskrit": {
            "devanagari": "ज्ञस्य या शक्ति:, तद्वियोगात्, ज्ञातृत्व-शक्तिवियोगादित्यर्थ:। उक्तप्रकारव्यतिरिक्तप्रकारेण प्रधानानुमितौ च प्रधानस्य ज्ञातृत्वशक्तिवियोगात् रचनानुपपत्त्यादयो दोषास्तदवस्था:"
          }
        }
      },
      {
        "ref": "2.2.8",
        "content": {
          "sanskrit": {
            "devanagari": "प्रधानाभ्युपगमेऽपि प्रयोजनाभावान्न तदनुमेयम्। पुरुषस्य निर्विकारस्य प्रधानदर्शनरूपविकारासंभवात्, प्रकृतिधर्माध्यासनिमित्तभोग: तद्विवेकानुसन्धानकृत-कैवल्यं च न संभवति"
          }
        }
      },
      {
        "ref": "2.2.9",
        "content": {
          "sanskrit": {
            "devanagari": "पुरुषस्य द्रष्टृत्वभोक्तृत्वनिर्विकारत्वादिविरुद्ध-सहस्राभ्युपगमाच्च असमञ्जसं कापिलमतम्"
          }
        }
      },
      {
        "ref": "2.2.10",
        "content": {
          "sanskrit": {
            "devanagari": "असमञ्जसमिति वर्तते। वा शब्दश्चार्थे। ह्रस्वपरिमण्डलाभ्यां महद्दीर्घवत् - द्व्यणुकत्र्यणुकोत्पत्तिवदन्यच्च तन्मतं सर्वमसमञ्जसम्। अवयवास्स्वकीयैष्षड्भि: पार्श्वैस्संयुज्यमाना हि पृथुतरमवयविनमारभन्ते, परमाणूनां निरवयवत्वेन पार्श्वानभ्युपगमात्, पार्श्वाननपेक्ष्य संयुज्यमानानां न पृथुतरद्रव्यारम्भकत्वसंभव:"
          }
        }
      },
      {
        "ref": "2.2.11",
        "content": {
          "sanskrit": {
            "devanagari": "अणुगताद्यकर्मासंभवात्तत्कृताणुसंयोगाभावात् क्षेत्रज्ञादृष्टानां विपाकापेक्षत्वेऽपि न तत्कृतकादाचित्काणुगतकर्मसंभव:। अनपेक्षत्वे प्रागप्युत्पादकं स्यात्। विपाको नाम कश्चिददृष्टगतो धर्मो न ज्ञायते, कर्मविधिवेलायामेव कालविशेषनियत- फलदायित्वं यस्य कर्मणश्चोदितम्, तस्य तत्कालागम एव विपाक:। अनियतकालविशेषाणां कर्मणां प्रबलकर्मान्तराप्रतिबन्ध एव विपाक:। अदृष्टानि च तत्तत्कर्मानुगुणफलदानस्वभावानि, अतोऽनन्तैः आत्मभि: विविधकालफलदायित्वेनानुष्ठितानामेकदैकरूपविपाको न संभवति। अनुमेयेश्वरासिद्धेः तदधिष्ठानाच्च न संभवति"
          }
        }
      },
      {
        "ref": "2.2.12",
        "content": {
          "sanskrit": {
            "devanagari": "समवायाभ्युपगमाच्चासमञ्जसम्, समवायस्यापि जातिगुणादेरिवापृथक्सिद्धिहेत्वपेक्षासाम्यादनवस्थिते:, समवायस्य तत्स्वभाव-कल्पनायां जात्यादेरेव तन्न्याय्यम्"
          }
        }
      },
      {
        "ref": "2.2.13",
        "content": {
          "sanskrit": {
            "devanagari": "समवायस्य नित्यत्वाभ्युपगमे संबन्धिनित्यत्वमन्तरेण तदनुपपत्ते:, अवयवावयविनोरुभयोर्नित्यत्वप्रसङ्गादसदेवेदम्"
          }
        }
      },
      {
        "ref": "2.2.14",
        "content": {
          "sanskrit": {
            "devanagari": "परमाणूनां रूपादिमत्त्वान्नित्यत्वादिविपर्ययश्च, घटादिषु तथा दर्शनात्"
          }
        }
      },
      {
        "ref": "2.2.15",
        "content": {
          "sanskrit": {
            "devanagari": "अनित्यत्वादिभयाद्रूपादिशून्यत्वे कारणगुणपूर्वकत्वासिद्धि:, तद्भयाद्रूपादिमत्त्वे च अनित्यत्वादिरित्युभयधा च दोषादसमञ्जसमेव"
          }
        }
      },
      {
        "ref": "2.2.16",
        "content": {
          "sanskrit": {
            "devanagari": "काणादपक्षे कस्याप्यंशस्य वैदिकैरपरिग्रहात् अनुपपन्नत्वात् च, अत्यन्तमनपेक्षा"
          }
        }
      },
      {
        "ref": "2.2.17",
        "content": {
          "sanskrit": {
            "devanagari": "अणुहेतुके पृथिव्यादिसमुदाये, पृथिव्यादिहेतुके शरीरेन्द्रियसमुदाये च सुगताभ्युपगते तदभ्युपगमप्रकारेणैव समुदायासिद्धि:। क्षणिकत्वं हि तैरभ्युपगम्यते, संहतौ व्याप्रियमाणा: परमाणव: पृथिव्यादयश्च तदानीमेव नष्टाश्चेत् के समुदायरूपेण संहन्यन्ते?"
          }
        }
      },
      {
        "ref": "2.2.18",
        "content": {
          "sanskrit": {
            "devanagari": "अस्थिरेषु स्थिरत्वबुद्धिरूपाविद्या रागद्वेषादिपरम्परया अन्योन्यकारणत्वात्सर्वकारणत्वमुपपन्नमिति चेत्, न, अविद्यायास्सङ्घातभावानिमित्तत्वात्। न हि शुक्तिकादिषु रजतादिबुद्धिरूपाविद्यया शुक्तिकादिर्वस्तुतो रजतादिकार्यं करोति। अत्र विदुषस्तदानीमेव नष्टत्वात् अविद्यानिमित्त-रागादयोऽपि न संभवन्ति"
          }
        }
      },
      {
        "ref": "2.2.19",
        "content": {
          "sanskrit": {
            "devanagari": "उत्तरघटक्षणोत्पत्तौ पूर्वघटक्षणस्यापि नष्टत्वेन अभावस्यैवोत्पादकत्वाविशेषेण सर्वदोत्पत्तिश्च स्यात्"
          }
        }
      },
      {
        "ref": "2.2.20",
        "content": {
          "sanskrit": {
            "devanagari": "असत उत्पात्तावधिपतिसहकार्यादीनां ज्ञानहेतुत्वप्रतिज्ञाविरोधश्च। तस्यापि स्थित्यभ्युपगमे युगपत् घटद्वयोपलब्धिप्रसक्ति:, अस्थितौ च संप्रयोगज्ञानापत्ते: यौगपद्यम्"
          }
        }
      },
      {
        "ref": "2.2.21",
        "content": {
          "sanskrit": {
            "devanagari": "निरोध: - निरन्वयविनाश:। स स्थूल: सूक्ष्मश्च न संभवति, कपालादिभावरूपावस्थाप्राप्तेरेव विनाशशब्दाभिधेयत्वात्, सतो द्रव्यस्य अविच्छेदात्"
          }
        }
      },
      {
        "ref": "2.2.22",
        "content": {
          "sanskrit": {
            "devanagari": "उत्पन्नस्य तुच्छतापत्तौ तुच्छादुत्पत्तौ च भावादुत्पत्त्यसंभवात् अभावात्मककार्यापत्तिरूपदोषात्तुच्छत्वासिद्धि:"
          }
        }
      },
      {
        "ref": "2.2.23",
        "content": {
          "sanskrit": {
            "devanagari": "आकाशे च न तुच्छत्वम्, अबाधितप्रतीत्यविशेषात्। प्रतीयते ह्याकाश: श्येनादिपतनदेशत्वेन"
          }
        }
      },
      {
        "ref": "2.2.24",
        "content": {
          "sanskrit": {
            "devanagari": "प्रत्यभिज्ञानाच्च न क्षणिकत्वसिद्धि:। तदेवेदमिति हि सामानाधिकरण्येन अतीतवर्तमानदेशकालविशिष्टं वस्तु एकमिति प्रतीयते। अस्याश्च सामग्री पूर्वानुभव- जनितसंस्कारवत: पुरुषस्येन्द्रियसंप्रयोग:"
          }
        }
      },
      {
        "ref": "2.2.25",
        "content": {
          "sanskrit": {
            "devanagari": "ज्ञानाकारवैचित्र्येण ज्ञाने स्वाकारं समर्प्य विनष्टमप्यर्थमनुमिनोति इति वादश्च न संभवति, असतो विनष्टस्य धर्मिणो धर्मसंक्रमणस्यादृष्टत्वात्। (ज्ञाने नीलाद्याकार उपलभ्यते, स विनष्टस्यासतोऽर्थस्याकारो भवितुं नार्हाति। कुत:? अदृष्टत्वात्। न खलु धर्मिणि विनष्टे तद्धर्मस्यार्थान्तरे संक्रमणं दृष्टम्।)"
          }
        },
        "references": [
          {
            "start": 141,
            "end": 295,
            "display_text": "ज्ञाने नीलाद्याकार उपलभ्यते, स विनष्टस्यासतोऽर्थस्याकारो भवितुं नार्हाति। कुत:? अदृष्टत्वात्। न खलु धर्मिणि विनष्टे तद्धर्मस्यार्थान्तरे संक्रमणं दृष्टम्।",
            "grantha_id": null,
            "edition_id": null,
            "locator": null,
            "locator_end": null,
            "group_id": null,
            "unresolved": true
          }
        ]
      },
      {
        "ref": "2.2.26",
        "content": {
          "sanskrit": {
            "devanagari": "क्षणिकत्वाभ्युपगमे अनुष्ठातुरन्यत्वात् फलिनां निष्प्रयत्नानामपि सर्वार्थसिद्धिस्स्यात्"
          }
        }
      },
      {
        "ref": "2.2.27",
        "content": {
          "sanskrit": {
            "devanagari": "ज्ञानव्यतिरिक्तार्थाभाववादश्च न संभवति, घटमहं जानामीति कर्तृज्ञानकर्मतयाऽर्थस्योपलब्धे: न तदभावश्शक्यते वक्तुम्। पुरुषस्यार्थविशेषव्यवहारानुगुण्य-आपादकत्वमेव ज्ञानस्याकार:"
          }
        }
      },
      {
        "ref": "2.2.28",
        "content": {
          "sanskrit": {
            "devanagari": "क(का)रण दोषबाधकप्रत्ययराहित्यरूपवैषम्याच्च न स्वप्नादिवज्जागरितज्ञानस्य मिथ्यात्वम्"
          }
        },
        "references": [
          {
            "start": 2,
            "end": 4,
            "display_text": "का",
            "grantha_id": null,
            "edition_id": null,
            "locator": null,
            "locator_end": null,
            "group_id": null,
            "unresolved": true
          }
        ]
      },
      {
        "ref": "2.2.29",
        "content": {
          "sanskrit": {
            "devanagari": "अर्थशून्यस्य ज्ञानस्य सद्भावो न संभवति, अनुपलब्धे:। स्वप्नज्ञानस्याप्यर्थवत्तोपपादयिष्यते"
          }
        }
      },
      {
        "ref": "2.2.30",
        "content": {
          "sanskrit": {
            "devanagari": "सर्वशून्यवादश्च न संभवति। सदिति प्रतिज्ञायामसदिति प्रतिज्ञायां च तुच्छता न संभवति, अनुपपत्ते:। सदसद्बुद्धीनां वस्तुगताऽन्योन्य- विरुद्धभावरूपावस्थाविशेषविषयत्वात्"
          }
        }
      },
      {
        "ref": "2.2.31",
        "content": {
          "sanskrit": {
            "devanagari": "अर्हतो मतं न युक्तिमत्। एकस्मिन् वस्तुनि युगपत् सत्त्वासत्त्वनित्यत्वानित्यत्वभेदाभेदानामसंभवात्। पर्यायरूपाश्च द्रव्यस्यास्तित्वादिशब्दबुद्धिविषया: परस्पर विरुद्धपिण्डत्वघटत्वकपालत्वाद्यवस्था: युगपन्न संभवन्ति, तथा, घटत्वशरावत्वावस्थाश्च पृथिव्यादे: प्रदेशभेदेन। तथा च द्रव्यस्यानित्यत्वमुत्पत्तिविनाशयोगित्वं तद्विपरीतं नित्यत्वं नैकस्मिन् समवैति"
          }
        }
      },
      {
        "ref": "2.2.32",
        "content": {
          "sanskrit": {
            "devanagari": "आत्मनश्शरीरपरिमाणत्वे बृहतश्शरीरादल्पीयसि प्रविशत: आकार्त्स्न्यं - विकल्पत्वं प्रसज्येत"
          }
        }
      },
      {
        "ref": "2.2.33",
        "content": {
          "sanskrit": {
            "devanagari": "तथा सङ्कोचविकासावस्थायोगादपि नाविरोध:, घटादिवद्विकारादियोगप्रसक्ते:"
          }
        }
      },
      {
        "ref": "2.2.34",
        "content": {
          "sanskrit": {
            "devanagari": "अन्त्यस्य - मोक्षावस्थापरिमाणस्य, एकरूपावस्थिते:, तस्य स्वाभाविकत्वेनात्मतत्परिमाणयोरुभयोर्नित्यत्वेन पूर्वत्रापि अविशेष:। विविध देहपरिमाणत्वे वैकल्यं स्यादेव"
          }
        }
      },
      {
        "ref": "2.2.35",
        "content": {
          "sanskrit": {
            "devanagari": "नेति वर्तते। पशुपतेर्मतमनादरणीयं वेदविरुद्ध- निमित्तोपादानभेदतद्विरुद्धाचारपरत्वेन असामञ्जस्यात्"
          }
        }
      },
      {
        "ref": "2.2.36",
        "content": {
          "sanskrit": {
            "devanagari": "अनुमेयेश्वराभ्युपगमेन हि केवलाधिष्ठातृत्वमुच्यते, तथा सति अशरीरस्य प्रधानाधिष्ठानानुपपत्ते:, सशरीरत्वे तु शरीरोत्पत्त्यनिरूपणात्, सावयवस्य तस्य नित्यत्वे महीमहीधरादीनामपि नित्यत्वाविरोधाच्च"
          }
        }
      },
      {
        "ref": "2.2.37",
        "content": {
          "sanskrit": {
            "devanagari": "करणकळेबराद्यधिष्ठानवदशरीरस्यैवाधिष्ठानमिति चेन्न। पुण्यपापनिमित्तत्वात्तस्य तत्फलभोगादिप्रसक्ते:"
          }
        }
      },
      {
        "ref": "2.2.38",
        "content": {
          "sanskrit": {
            "devanagari": "तथा सति क्षेत्रज्ञवत् अन्तवत्त्वमसर्वज्ञता च"
          }
        }
      },
      {
        "ref": "2.2.39",
        "content": {
          "sanskrit": {
            "devanagari": "साङ्ख्यादिवत्पञ्चरात्रमपि जीवोत्पत्त्यभिधानात्, श्रुतिविरुद्धत्वेन तदसंभवादप्रमाणम्"
          }
        }
      },
      {
        "ref": "2.2.40",
        "content": {
          "sanskrit": {
            "devanagari": "कर्तु: - जीवात्, करणं - मनश्च, श्रुतावुत्पद्यते इति नोच्यते, एतस्माज्जायते प्राणो मनस्सर्वेन्द्रियाणि च इत्यादि श्रुते:"
          }
        }
      },
      {
        "ref": "2.2.41",
        "content": {
          "sanskrit": {
            "devanagari": "वासुदेवात्सङ्कर्षणो नाम जीव: इत्यादौ सङ्कर्षणादीनां विज्ञानादिरूपवासुदेवत्वे सति तदभिधायिन: प्रामाण्यानिषेध:। परब्रह्मवासुदेवस्य श्रुतावपि अजायमानो बहुधा विजायते इति चावतारश्श्रूयते जीवादिशब्दा: तत्तच्छरीरकसङ्कर्षणादीनां वाचका:"
          }
        }
      },
      {
        "ref": "2.2.42",
        "content": {
          "sanskrit": {
            "devanagari": "तस्मिन्नपि तन्त्रे व्याप्तिरूपेण संबन्धस्तस्याश्च पुरुषस्य च।\n\nस ह्यनादिरनन्तश्च परमार्थेन निश्चित :॥ इति जीवोत्पत्तिप्रतिषेधाच्चाविरोधश्श्रुत:\n\nइति श्रीभगवद्रामानुजविरचिते श्रीवेदान्तसारेद्वितीयाध्याये द्वितीय : पाद : ।"
          }
        }
      }
    ]
  }
}