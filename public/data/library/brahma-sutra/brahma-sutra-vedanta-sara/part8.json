          "devanagari": "अकरणत्वाच्च न दोषस्तथा हि दर्शयति ॥ २-४-१० ॥"
        }
      }
    },
    {
      "ref": "2.4.11",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "पञ्चवृत्तिर्मनोवद्व्यपदिश्यते ॥ २-४-११ ॥"
        }
      }
    },
    {
      "ref": "2.4.12",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अणुश्च ॥ २-४-१२ ॥"
        }
      }
    },
    {
