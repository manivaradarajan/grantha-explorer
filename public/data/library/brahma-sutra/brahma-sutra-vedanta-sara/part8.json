        }
      }
    },
    {
      "ref": "2.4.17",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "संज्ञामूर्तिकॢप्तिस्तु त्रिवृत्कुर्वत उपदेशात् ॥ २-४-१७ ॥"
        }
      }
    },
    {
      "ref": "2.4.18",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "मांसादि भौमं यथाशब्दमितरयोश्च ॥ २-४-१८ ॥"
        }
      }
    },
    {
      "ref": "2.4.19",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "वैशेष्यात्तु तद्वादस्तद्वाद : ॥ २-४-१९ ॥"
        }
      }
    }
  ],
  "commentary": {
    "commentary_id": "vedanta-sara",
    "commentary_title": "श्रीवेदान्तसारः",
    "commentator": {
      "devanagari": "भगवद् रामानुजः",
      "roman": "bhagavad rāmānujaḥ"
    },
    "passages": [
      {
        "ref": "2.4.1",
        "content": {
          "sanskrit": {
            "devanagari": "यथा जीवोत्पत्ति: नित्यत्वश्रुतेर्नोपपद्यते। तथेन्द्रियाण्यपि, असद्वा इदमग्र आसीत्, ऋषयो वाव तेऽग्रे सदासीत्।। प्राणा वा व ऋषय: इति प्रलयकाले प्राणानां स्थित्युपदेशात्"
          }
        }
      },
      {
        "ref": "2.4.2",
        "content": {
          "sanskrit": {
            "devanagari": "तस्य परमात्मन एव सृष्टे: प्रागवस्थानश्रुते: ऋषिशब्द: प्राणशब्दश्च परमात्मन्येव। बहुत्वासंभवात्, बहुवचनश्रुतिर्गौणी"
          }
        }
      },
      {
        "ref": "2.4.3",
        "content": {
          "sanskrit": {
            "devanagari": "परमात्मन: सृष्टिपूर्वकत्वात् इतरेषां नामयोग्यस्य तदानीं प्राणशब्दो नेन्द्रियविषय:"
          }
        }
      },
      {
        "ref": "2.4.4",
        "content": {
          "sanskrit": {
            "devanagari": "सप्तैवेन्द्रियाणि। सप्तप्राणा: , यदा पञ्चावतिष्ठन्ते ज्ञानानि मनसा सह । बुद्धिश्च इति सप्तानामेव सहगतेस्तेषामेव योगे विशेषितत्वाच्च"
          }
        }
      },
      {
        "ref": "2.4.5",
        "content": {
          "sanskrit": {
            "devanagari": "हस्तादयोऽपीन्द्रियाणि, जीवे देहान्तरवस्थिते उपकारकत्वाविशेषात्; अतो न सप्तैव; अपि त्वेकादश, दशेमे पुरुषे प्राणा आत्मैकादश: , इन्द्रियाणि दशैकं च इति श्रुतिस्मृतिभ्याम्, बुद्ध्यादय: मनोवृत्ति भेदा:। सप्तानां गतिश्रवणं विशेषणं च तेषां प्राधान्यात्"
          }
        }
      },
      {
        "ref": "2.4.6",
        "content": {
          "sanskrit": {
            "devanagari": "तानि चाणूनि । प्राणमनूत्क्रामन्तं सर्वे प्राणा अनूत्क्रामन्ति इति गतिश्रवणात्"
          }
        }
      },
      {
        "ref": "2.4.7",
        "content": {
          "sanskrit": {
            "devanagari": "श्रेष्ठ: - पञ्चवृत्ति: प्राणोऽप्युत्पद्यते। उत्तरचिन्तार्थोऽय मनुवाद:"
          }
        }
      },
      {
        "ref": "2.4.8",
        "content": {
          "sanskrit": {
            "devanagari": "पञ्चवृत्तिप्राण: न वायुमात्रम्, तत्क्रिया वा । एतस्माज्जायते प्राण:। खं वायुरिति पृथगुपदेशात्"
          }
        }
      },
      {
        "ref": "2.4.9",
        "content": {
          "sanskrit": {
            "devanagari": "वायो: पृथग्भूतोऽयम्, नाग्न्यादिवत् भूतान्तरम्, वायुरेव देहधारणयोग्याकारमापन्न: चक्षुरादिवत् जीवोपकरणम्, चक्षुरादिभिस्सहोपदेशतत्तुल्योपकार-तन्मुख्यत्वेभ्य:"
          }
        }
      },
      {
        "ref": "2.4.10",
        "content": {
          "sanskrit": {
            "devanagari": "करणम् - क्रिया; न जीवोपकाररूपक्रियारहितत्वे दोष:; यत: श्रुतिरेव देहेन्द्रियाद्यशैथिल्यकरणं दर्शयति, प्राणोत्क्रमणे देहेन्द्रियादिशैथिल्याभिधानात्"
          }
        }
      },
      {
        "ref": "2.4.11",
        "content": {
          "sanskrit": {
            "devanagari": "प्राण एक एव स्ववृत्तिभि: पञ्चभि: प्राणापानादिनामभाग्भवति। कामादिभिर्यथैकमेव मन: । काम: संकल्प: इत्यारभ्य एतत्सर्वं मन एव इति"
          }
        }
      },
      {
        "ref": "2.4.12",
        "content": {
          "sanskrit": {
            "devanagari": "प्राणोऽनूत्क्रामतीत्युत्क्रान्तेरणु:"
          }
        }
      },
      {
        "ref": "2.4.13",
        "content": {
          "sanskrit": {
            "devanagari": "जीवेन सह अग्न्यादे: इन्द्रियाद्यधिष्ठानम् परमात्मसङ्कल्पादेव भवति। योऽग्नौ तिष्ठन् योऽग्निमन्तरो यमयतीत्यादिशब्दात्"
          }
        }
      },
      {
        "ref": "2.4.14",
        "content": {
          "sanskrit": {
            "devanagari": "सर्वस्य तन्नियाम्यत्वनियमात्"
          }
        }
      },
      {
        "ref": "2.4.15",
        "content": {
          "sanskrit": {
            "devanagari": "श्रेष्ठादन्यत्र ये प्राणा: त इन्द्रियाणि, तेष्वेवेन्द्रियव्यपदेशात्। इन्द्रियाणि दशैकं चेत्यादि"
          }
        }
      },
      {
        "ref": "2.4.16",
        "content": {
          "sanskrit": {
            "devanagari": "एतस्माज्जायते प्राणो मनस्सर्वेन्द्रियाणि च इति भेदेनोत्पत्तिश्रुते:, इन्द्रियवृत्त्युपरमेऽपि प्राणवृत्त्यनुपरमवैलक्षण्याच्च"
          }
        }
      },
      {
        "ref": "2.4.17",
        "content": {
          "sanskrit": {
            "devanagari": "देवादिनामरूपव्यष्टिसृष्टि: चतुर्मुखशरीरकात् परमात्मन एव, न केवलचतुर्मुखात्; नामरूपे व्याकरणवाणि तासां त्रिवृतं त्रिवृतमेकैकां करवाणि इति त्रिवृत्करणं कुर्वतो नामरूपव्याकरणोपदेशात्। त्रिवृत्करणं तु केवलचतुर्मुखस्य न संभवति, त्रिवृत्कृतैस्तेजोबन्नैरण्डमुत्पाद्य पश्चाच्चतुर्मुखसृष्टि:, तदण्डमभवद्धैमम् तस्मिञ्जज्ञे स्वयंब्रह्मा इत्यादि स्मृते:"
          }
        }
      },
      {
        "ref": "2.4.18",
        "content": {
          "sanskrit": {
            "devanagari": "अन्नमशितं त्रेधा विधीयते इत्यत्र प्रागुक्तत्रिवृत्करणादर्थान्तरभूत: अण्डान्तर्वर्तिपुरुषभुक्तान्नादीनां परिणामप्रकार उच्यते। अन्यथा मांसमनसो: पुरीषादणीयस्त्वेनाप्यत्वतैजसत्वप्रसक्ति:। तथा सति अन्नमशितं त्रेधा इति भूमेरेव त्रिधात्वोपक्रम:, अन्नमयं हि सोम्य मन : इति मनसो भौमत्वं च विरुध्यते। तथेतरयो: अप्तेजसो: त्रैविध्यं विरुध्यते, तदिदमाह - मांसादिभौमं यथा शब्दमितरयोश्चेति । पुरीषवन्मांसमनसी अपि भौमे इतीहोच्यते। तथा मूत्रवल्लोहितप्राणावप्याप्यौ। तथा अस्थिवन्मज्जावाचौ तैजस्यौ\n\nपूर्वमेव त्रिवृत्कृतं चेत्, त्र्यात्मकं वस्तु कथमन्नमापस्तेज इत्युच्यत इत्यत्राह -"
          }
        }
      },
      {
        "ref": "2.4.19",
        "content": {
          "sanskrit": {
            "devanagari": "अन्नादिभूयस्त्वेन वैशेष्यादन्नादिवाद:\n\nइति श्रीभगवद्रामानुजविरचिते श्रीवेदान्तसारे द्वितीयस्याध्यायस्य\n\nचतुर्थ : पाद : । समाप्तश्चाध्याय : ॥"
          }
        }
      }
    ]
  }
}