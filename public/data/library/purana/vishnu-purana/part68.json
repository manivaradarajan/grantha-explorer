{
  "kind": "grantha-part",
  "schema_version": "1.4.0",
  "grantha_id": "vishnu-purana",
  "edition_id": "vishnu-purana",
  "part_num": 68,
  "passages": [
    {
      "ref": "4.12.1",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "क्रोष्टोस्तु यदुपुत्रस्यात्मजो ध्वजिनीवान्"
        }
      },
      "speaker": "श्रीपराशर उवाच"
    },
    {
      "ref": "4.12.2",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "ततश्च स्वातिः ततो रुशङ्कुः रुशङ्कोश्चित्ररथः"
        }
      }
    },
    {
      "ref": "4.12.3",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तत्तनयः शशिबिन्दुः चतुर्दशमहारत्नेशश्चक्रवर्त्यभवत्"
        }
      }
    },
    {
      "ref": "4.12.4",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तस्य च शतसहस्रं पत्नी नामभवत्"
        }
      }
    },
    {
      "ref": "4.12.5",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "दशलक्षसंख्याश्च पुत्राः"
        }
      }
    },
    {
      "ref": "4.12.6",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तेषां च पृथुश्रवाः पृथुकर्मा पृथुकीर्तिः पृथुयशाः पृथुजयः पृथुदानः षट्पुत्राः प्रधानाः"
        }
      }
    },
    {
      "ref": "4.12.7",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "पृथुश्रवसश्च पुत्रः पृथुतमः"
        }
      }
    },
    {
      "ref": "4.12.8",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तस्मादुशना यो वाजिमेधानां शतमाजहार"
        }
      }
    },
    {
      "ref": "4.12.9",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तस्य च शितपुर्नाम पुत्रोऽभवत्"
        }
      }
    },
    {
      "ref": "4.12.10",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तस्यापि रुक्मकवचस्ततः परवृत्"
        }
      }
    },
    {
      "ref": "4.12.11",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तस्य परावृतो रुक्मेषुपृथुज्यामघवलितहरितसंज्ञास्तस्य पञ्चात्मजा बभूवुः"
        }
      }
    },
    {
      "ref": "4.12.12",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तस्माद्यापि ज्यामघस्य श्लोको गीयते"
        }
      }
    },
    {
      "ref": "4.12.13",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "भार्यावश्यास्तु ये केचिद्भविष्यन्त्यथ वा मृताः ।\nतेषां तु ज्यामघः श्रेष्ठः शैव्यापतिरभून्नृपः"
        }
      }
    },
    {
      "ref": "4.12.14",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "अपुत्रा तस्य सा पत्नी शैव्या नाम तथाप्यसौ ।\nअपत्यकामोऽपि भयान्नान्यां भार्यामविन्दत"
        }
      }
    },
    {
      "ref": "4.12.15",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "स त्वेकदा प्रभूतरथतुरगगजसंमर्दातिदारुणे महाहवे युद्ध्यमानःच सकलमेवारिचक्रमजयत्"
        }
      }
    },
    {
      "ref": "4.12.16",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तच्चारिचक्रमपास्तपुत्रकलत्रबन्धुबलकोशं स्वमधिष्ठानं परित्यज्य दिशः प्रतिविद्रुतम्"
        }
      }
    },
    {
      "ref": "4.12.17",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तस्मिंश्च विद्रुतेतित्रासलोलायतलोचनयुगलं त्राहित्राहि मां तातांब भ्रतरित्याकुलविलापविधुरं स राजकन्यारत्नमद्राक्षीत्"
        }
      }
    },
    {
      "ref": "4.12.18",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तद्दर्शनाच्च तस्यामनुरागनुगतान्तरात्मा स नृपोऽचिन्तयत्"
        }
      }
    },
    {
      "ref": "4.12.19",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "साध्विदं ममापत्यरहितस्य वन्ध्याभर्तुः सांप्रतं विधिनापत्यकारणं कन्यारत्नमुपपादितम्"
        }
      }
    },
    {
      "ref": "4.12.20",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तदेतत्समुद्वहामीति"
        }
      }
    },
    {
      "ref": "4.12.21",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "अथ वैनां स्यन्दनमारोप्य स्वमधिष्ठानं नयामि"
        }
      }
    },
    {
      "ref": "4.12.22",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तयैव देव्याशैव्ययाहमनुज्ञातःसमुद्वहामीति"
        }
      }
    },
    {
      "ref": "4.12.23",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "अथैनां रथमारोप्य स्वनगरमगच्छत्"
        }
      }
    },
    {
      "ref": "4.12.24",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "विजयिनं च राजानमशेषपौरभृत्वयरिजनामात्यसमेता शैव्या द्रष्टुमधिष्ठनद्वारमागता"
        }
      }
    },
    {
      "ref": "4.12.25",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "सा चावलोक्य राज्ञः सव्यपार्शववर्त्तिनीं कन्यामीषदुद्भूतामर्षस्फुरदधरपल्लवा राजानमवोचत्"
        }
      }
    },
    {
      "ref": "4.12.26",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "अतिचपलचित्तात्र स्यन्दने केयमारोपितेति"
        }
      }
    },
    {
      "ref": "4.12.27",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "असावप्यनालोचितोत्तरवचनोतिभयात्तामाह स्नुषा ममेयमिति"
        }
      }
    },
    {
      "ref": "4.12.28",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "अथैनं शैव्योवाच"
        }
      }
    },
    {
      "ref": "4.12.29",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "नाहं प्रसूता पुत्रेण नान्या पत्न्यभवत्तव ।\nस्नुषासंबन्धता ह्योषा कतमेन सुतेन ते"
        }
      }
    },
    {
      "ref": "4.12.30",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "इत्यात्मेर्ष्याकोपकलुषितवचनमुषितविवेको भयाद्दुरुक्तापरिहारार्थमिदमवनीपतिराह"
        }
      },
      "speaker": "श्रीपराशर उवाच"
    },
    {
      "ref": "4.12.31",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "यस्ते जनिष्यत्यात्मजस्तस्येयमनागतस्यैव भार्या निरूपितेत्याकर्ण्योद्भूतमृदुहासा तथेत्याह"
        }
      }
    },
    {
      "ref": "4.12.32",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "प्रविवेश च राज्ञा सहाधिष्ठानम्"
        }
      }
    },
    {
      "ref": "4.12.33",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "अनन्तरं चातिशुद्धलग्नहोरांशकावयवोक्तकृतपुत्रजन्मलाभगुणाद्वयसः परिणाममुपगतापि शैव्या स्वल्पैरेवाहोभिर्गर्भमवाप"
        }
      }
    },
    {
      "ref": "4.12.34",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "कालेन च कुमारमजीजनत्"
        }
      }
    },
    {
      "ref": "4.12.35",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तस्य च विदर्भ इति पिता नाम चक्रे"
        }
      }
    },
    {
      "ref": "4.12.36",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "स च तां स्नुषामुपयेमे"
        }
      }
    },
    {
      "ref": "4.12.37",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तस्यां चासौक्रथकैशिकसंज्ञौ पुत्रावजनयत्"
        }
      }
    },
    {
      "ref": "4.12.38",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "पुनश्च तृतीयं रोमपादसंज्ञं पुत्रमजीजनद्यो नारदादवाप्तज्ञानवान्भविष्यतीति"
        }
      }
    },
    {
      "ref": "4.12.39",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "रोमपादाद्बभ्रुः बभ्रोर्धृतिर्ः धृतेः कैशिकः कैशिकस्यापि चेदिः पुत्रोऽभवत्यस्य संततौ चैद्या भूपालाः"
        }
      }
    },
    {
      "ref": "4.12.40",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "क्रथस्य स्नषापुत्रस्यकुन्तिरभवत्"
        }
      }
    },
    {
      "ref": "4.12.41",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "कुन्तेर्धृष्टिः धृष्टेर्निधृतिः निधृतेर्दशार्हस्ततश्च व्योमः तस्यापि जीमूतः ततश्च विकृतिः ततश्च भीभरथः तस्मान्नवरथः तस्यापि दशरथः ततश्च शकुनिः तत्तनयः करंभिः करंभेर्देवरातोऽभवत्"
        }
      }
    },
    {
      "ref": "4.12.42",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तस्माद्देवक्षत्रः तस्यापि मधुः मधोः कुमारवंशः कुमारवंशादनुः अनोः पुरुमित्रः पृथिवीपतिरभवत्"
        }
      }
    },
    {
      "ref": "4.12.43",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "ततश्चांशुस्तस्माच्च सत्वतः"
        }
      }
    },
    {
      "ref": "4.12.44",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "सत्वतादेते सात्वताः"
        }
      }
    },
    {
      "ref": "4.12.45",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "इत्येतां ज्यामघस्य संततिं सम्यक्छ्रद्धासमन्वितः श्रुत्वा पुमान्मैत्रेय स्वपापैः प्रमुच्यते"
        }
      }
    },
    {
      "ref": "4.12.46",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "इति श्रीविष्णुमाहापुराणे चतुर्थांशे द्वादशोऽध्यायः (१२)"
        }
      }
    }
  ]
}