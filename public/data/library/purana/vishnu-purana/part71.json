{
  "kind": "grantha-part",
  "schema_version": "1.4.0",
  "grantha_id": "vishnu-purana",
  "edition_id": "vishnu-purana",
  "part_num": 71,
  "passages": [
    {
      "ref": "4.15.1",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "हिरण्यकशिपुत्वे च रावणत्वे च विष्णुना ।\nअवाप निहतो भोगानप्राप्यानमरैरपि"
        }
      },
      "speaker": "मैत्रेय उवाच"
    },
    {
      "ref": "4.15.2",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "न लयं तत्र तेनैव निहतः स कथं पुनः ।\nसंप्राप्तः शिशुपालत्वे सायुज्यं शाश्वते हरौ"
        }
      }
    },
    {
      "ref": "4.15.3",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "एतदिच्छाम्यहं श्रोतुं सर्वधर्मभृत्तां वर ।\nकौतूहलपरेणैतत्पृष्टो मे वक्तुमर्हसि"
        }
      }
    },
    {
      "ref": "4.15.4",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "दैत्येश्वरस्य वधायाशिललोकोत्पत्तिस्थितिविनाशकारिणा पूर्वं तनुग्रहणं कुर्वता नृसिंह रूपमाविष्कृतम्"
        }
      },
      "speaker": "श्रीपराशर उवाच"
    },
    {
      "ref": "4.15.5",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तत्र च हिरण्यकशिपोर्विष्णुरयमित्येतन्न मनस्यभूत्"
        }
      }
    },
    {
      "ref": "4.15.6",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "निरतिशयपुण्यसमुद्भूतमेतत्सत्त्वाजातमिति"
        }
      }
    },
    {
      "ref": "4.15.7",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "रजोद्रेकप्रेरितैकाग्रमतिस्तद्भावनायोगात्ततोवाप्तवधहैतुकीं निरतिशयामेवाखिलत्रैलोक्यकारीणीं दशाननत्वे भोगसंपदमवाप"
        }
      }
    },
    {
      "ref": "4.15.8",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "न तु स तस्मिन्ननादिनिधने परब्रह्मभूते भगवत्यनालंबिनि कृते मनसस्तल्लयमवाप"
        }
      }
    },
    {
      "ref": "4.15.9",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "एवं दशाननत्वेप्यनङ्गपराधीनतया जानकीसमासक्तचेतसा भगवता दाशरथि रूपधारिणा हतस्य तद्रूपदर्शनमेवासीत्नायमच्युत इत्यासक्तिर्विपद्यतोन्तःकरणे मानुषबुद्धिरेव केवलमस्याभूत्"
        }
      }
    },
    {
      "ref": "4.15.10",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "पुनरप्यच्युतविनिपातमात्रफलमखिलभूमण्डलश्लाघ्यचेदिराजकुले जन्म अव्याहतैश्वर्यं शिशुपालत्वेप्यवाप"
        }
      }
    },
    {
      "ref": "4.15.11",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तत्र त्वखिलानामेव स भगवन्नाम्नां त्वङ्कारकारणमभवत्"
        }
      }
    },
    {
      "ref": "4.15.12",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "ततश्च तत्कालकृतानां तेषामशेषणामेवाच्युतनाम्नामनवरतमनेकजन्मसु वर्धितविद्वेषानुबन्धिचित्तो विनिन्दनसंतर्जनादिषूच्चारणमकरोत्"
        }
      }
    },
    {
      "ref": "4.15.13",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तच्च रूपमुत्फुल्लपद्मदलामलाक्षिमत्युज्ज्वलपीतवस्त्रधार्यमलकिरिटकेयूरहारकटकादिशोभितमुदारचतुर्बाहुशङ्खचक्रगदाधरमतिप्ररूढवैरानुभावादटनभोजनस्नानासनशयनादिष्वशेषावस्थान्तरेषु नान्यत्रोपययावस्य चेतसः"
        }
      }
    },
    {
      "ref": "4.15.14",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "ततस्तमेवाक्रोशेषूच्चारयंस्तमेव हृदयेन धारयन्नात्मवधाय यावद्भगवद्धस्तचक्रांशुमालोज्ज्वालमक्षयतेजःस्वरूपं ब्रह्मभूतमपगतद्वेषादिदोषं भगवन्तमद्राक्षीत्"
        }
      }
    },
    {
      "ref": "4.15.15",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तावच्च भगवच्चक्रेणाशु व्यापादितस्तत्स्मरणदग्धाखिलाघसंचयो भगवतान्तमुपनीतस्ततस्मिन्नेव लयमुपययौ"
        }
      }
    },
    {
      "ref": "4.15.16",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "एतत्तवाखिलंमयाभिहितम्"
        }
      }
    },
    {
      "ref": "4.15.17",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "अयं हि भगवान् कीर्तितश्च संस्मृतश्च द्वेषानुबन्धेनापि अखिलमुरासुरादिर्दुल्लभं फलं प्रयच्छति किमुत सम्यग्भक्तिमत्मिति"
        }
      }
    },
    {
      "ref": "4.15.18",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "वसुदेवस्य त्वानकदुन्दुभेः पौरवीरोहिणीमदिराभद्रादेवकीप्रमुखा बह्व्यः पत्न्योऽभवन्"
        }
      }
    },
    {
      "ref": "4.15.19",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "बलभद्रशठसारणदुर्मदादीन्पुत्रार्त्नोहिण्यानकदुन्दुभिरुत्पादयामास"
        }
      }
    },
    {
      "ref": "4.15.20",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "बलदेवोपि रेवत्यां विशठोल्मुकौ पुत्रावजनयत्"
        }
      }
    },
    {
      "ref": "4.15.21",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "सार्ष्टिमार्ष्टिशिशुसत्यसत्यधृतिप्रमुखाः सारणात्मजाः"
        }
      }
    },
    {
      "ref": "4.15.22",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "भद्राश्वभद्रबाहुदुर्दमभूताद्याः रोहिण्याः कुलजाः"
        }
      }
    },
    {
      "ref": "4.15.23",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "नन्दोपनन्दकृतकाद्य मदिरायास्तनयाः"
        }
      }
    },
    {
      "ref": "4.15.24",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "भद्रायाश्चोपनिधिगदाद्याः"
        }
      }
    },
    {
      "ref": "4.15.25",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "वैशाल्यां च कौशिकमेकमेवाजनयत्"
        }
      }
    },
    {
      "ref": "4.15.26",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "आनकदुन्दुभेर्देवक्यामपि कीर्तिमत्सुषेणोदायुभद्रसेनऋजुदासभद्रदेवाख्याः षट्पुत्रा जज्ञिरे"
        }
      }
    },
    {
      "ref": "4.15.27",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तांश्च सर्वानेव कंसोघातितवान्"
        }
      }
    },
    {
      "ref": "4.15.28",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "अनन्तरं च सप्तमं गर्भमर्धरात्रे भगवत्प्रहितायोगनिद्रा रोहिण्या जठरमाकृष्य नीतवती"
        }
      }
    },
    {
      "ref": "4.15.29",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "कर्षणाच्चासावपि संकर्षणाख्यामगमत्"
        }
      }
    },
    {
      "ref": "4.15.30",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "ततश्च सकलजगन्महातरुमूलभूतोभूतभविष्यदादिसकलसुरासुरमुनिजनमनसामप्यगोचरोऽब्जभवप्रमुखैरनलमुखैः प्रणम्यावनिभारहरणाय प्रसादितो भगवाननादिमध्यनिधनोदेवकीगर्भमवततार वासुदेवः"
        }
      }
    },
    {
      "ref": "4.15.31",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तत्प्रसादविवद्धमानोरुमहिमा च योगनिद्रा नन्दगोपपत्न्या यशोदाया गर्भमधितिष्ठितवती"
        }
      }
    },
    {
      "ref": "4.15.32",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "सुप्रसन्नादित्यचन्द्रादिग्रहमव्यालादिभयं स्वस्थमानसमखिलमेवैतज्जगदपास्ताधर्ममभवत्त्स्मिश्च पुण्डरीकनयने जायमाने"
        }
      }
    },
    {
      "ref": "4.15.33",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "जातेन च तेनाखिलमेवैतत्सन्मार्गवर्ति जगदक्रियत"
        }
      }
    },
    {
      "ref": "4.15.34",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "भगवतोप्यत्र मर्त्यलोकेऽवतीर्णस्य षोडशसहस्राण्येकोत्तरशताधिकानि भार्याणाम भवन्"
        }
      }
    },
    {
      "ref": "4.15.35",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तासां च रुक्मिणी सत्यभामा जांबवती चारुहासिनीप्रमुखा ह्यष्टौ पत्न्यः प्रधाना बभूचवुः"
        }
      }
    },
    {
      "ref": "4.15.36",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तासु चाष्टावयुतानिलक्षं च पुत्राणां भगवानखिलमूर्तिरनादिमानजनयत्"
        }
      }
    },
    {
      "ref": "4.15.37",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तेषां च प्रद्युम्नचारुदेष्ण्यसांबादयः त्रयोदश प्रधानाः"
        }
      }
    },
    {
      "ref": "4.15.38",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "प्रद्युम्नोपि रुक्मिणस्तनयां रुक्मवतीं नामोपयेमे"
        }
      }
    },
    {
      "ref": "4.15.39",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तस्यामनिरुद्धो जज्ञे"
        }
      }
    },
    {
      "ref": "4.15.40",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "अनिरुद्धोऽपि रुक्मिणा एव पौत्रीं सुभद्रां नामो पयेमे"
        }
      }
    },
    {
      "ref": "4.15.41",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तस्यामस्य वज्रो जज्ञे"
        }
      }
    },
    {
      "ref": "4.15.42",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "वज्रस्य प्रतिबाहुः तस्यापि सुचारुः"
        }
      }
    },
    {
      "ref": "4.15.43",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "एवमनेकशतसहस्६ उषसंख्यस्य यदुकुलस्य पुत्रसंख्या वर्षशतैरपि वक्तुं न शक्यते"
        }
      }
    },
    {
      "ref": "4.15.44",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "यतो हि श्लोकाविमावत्र चरितार्थौ"
        }
      }
    },
    {
      "ref": "4.15.45",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तिस्त्रः कोट्यःसहस्राणामष्टाशीति शतानि च ।\nकुमाराणां कृहाचार्याश्चापयोगेषु ये रताः"
        }
      }
    },
    {
      "ref": "4.15.46",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "संख्यानं यादवानां कः करिष्यति महात्मनाम् ।\nयत्रायुतानामयुतलक्षेणास्ते सदाहुकः"
        }
      }
    },
    {
      "ref": "4.15.47",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "देवासुरे हता ये तु दैतेयास्सुमहाबलाः।\nउत्पन्नास्ते मनुष्येषु जनोपद्रवकारिणः"
        }
      }
    },
    {
      "ref": "4.15.48",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "तेषामुत्सादनार्थाय भुविदेवा यदोःकुले।\nअवतीर्णाःकुलशतं यत्रैकाभ्यधिकं द्विजः"
        }
      }
    },
    {
      "ref": "4.15.49",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "उत्पन्नास्ते मनुष्येषु प्रमाणे च प्रभुत्वे च व्यवस्थितः।\nनिदेशस्थायिनस्तस्य ववृधुः सर्वयादवाः"
        }
      }
    },
    {
      "ref": "4.15.50",
      "passage_type": "main",
      "kind": "Shloka",
      "content": {
        "sanskrit": {
          "devanagari": "इति प्रसूतिं वृष्णीनां यश्र्शृणोति नरः सदा ।\nस सर्वैः पातकैर्मुक्तो विष्णुलोकं प्रपद्यते"
        }
      }
    }
  ]
}