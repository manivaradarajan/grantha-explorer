{
  "kind": "grantha-part",
  "schema_version": "1.2.0",
  "grantha_id": "vishnu-purana",
  "edition_id": "vishnu-purana",
  "part_num": 60,
  "passages": [
    {
      "ref": "4.4.1",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "काश्यपदुहिता सुमतिर्विदर्भराजतनया केशिनी च द्वे भार्ये सगरस्यास्ताम्"
        }
      },
      "speaker": "श्रीपराशर उवाच"
    },
    {
      "ref": "4.4.2",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ताभ्यां चापत्यार्थमौर्वः परमेण समाधिनाराधितो वरमदात्"
        }
      }
    },
    {
      "ref": "4.4.3",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "एका वंशकरमेकं पुत्रमपरा षष्टिं पुत्रसहस्राणां जनयिष्यतीति यस्या यदभिमतं तदिच्छया गृह्यतामित्युक्ते केशिन्येकं वरयामास"
        }
      }
    },
    {
      "ref": "4.4.4",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "सुमतिः पुत्रसहस्राणि षष्टिं वव्रे"
        }
      }
    },
    {
      "ref": "4.4.5",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तथेत्युक्ते अल्पैरहोभिः केशिनी पुत्रमेकमसमंजसनामानं वंशकरमसूत"
        }
      }
    },
    {
      "ref": "4.4.6",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "काश्यपतनयायास्तु सुमत्याः षष्टिं पुत्रसहस्राण्यभवन्"
        }
      }
    },
    {
      "ref": "4.4.7",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्मादसमंजसादंशुमान्नाम कुमारो जज्ञे"
        }
      }
    },
    {
      "ref": "4.4.8",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "स त्वसमंजसो बालो बाल्यादेवासद्वृत्तोभूत्"
        }
      }
    },
    {
      "ref": "4.4.9",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "पिता चास्याचिंतयदयमतीतबाल्यः सुबुद्धिमान् भविष्यतीति"
        }
      }
    },
    {
      "ref": "4.4.10",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अथ तत्रापि च वयस्यतीते असच्चरितमेनं पिता तत्याज"
        }
      }
    },
    {
      "ref": "4.4.11",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तान्यपि षष्टिः पुत्रसहस्राण्यसमंजसचरितमेवानुचक्रुः"
        }
      }
    },
    {
      "ref": "4.4.12",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततश्चासमंजसचरितानुकारिभिस्सागरैरपध्वस्तयज्ञैसन्मार्गे जगति देवास्सकलविद्यामयमसंस्पृष्टमश्षोदोषैर्भगवतः पुरुषोत्तमस्यांशभूत कपिलं प्रणम्य तदर्थमूचुः"
        }
      }
    },
    {
      "ref": "4.4.13",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "भगवन्नेभिस्सगरतनयैरसमंजसचरितमनुगम्यते"
        }
      }
    },
    {
      "ref": "4.4.14",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "कथमेभिरसद्वृत्तमनुसरद्भिर्जगद्भविष्यतीति"
        }
      }
    },
    {
      "ref": "4.4.15",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अत्यार्त्त जगत्परित्राणाय च भगवतोत्र शरीरग्रहणमित्याकर्ण्य भगवानाहाल्पैरैव दिनैर्विनंक्ष्यन्तीति"
        }
      }
    },
    {
      "ref": "4.4.16",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अत्रांतरे च सगरो हयमेधमारभत"
        }
      }
    },
    {
      "ref": "4.4.17",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्य च पुत्रैरधिष्ठितमस्याश्वं कोप्यपहृत्य भुवो बिलं प्रविवेश"
        }
      }
    },
    {
      "ref": "4.4.18",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततस्तत्तनयाश्चाश्वखुरगतिनिर्वंधेनावनीमेकैको योजनं चख्नुः"
        }
      }
    },
    {
      "ref": "4.4.19",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "पाताले चाश्वं परिभ्रमंतं तमवनीपतितनयास्ते ददृशुः"
        }
      }
    },
    {
      "ref": "4.4.20",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "नातिदूरेऽवस्थितं च भगवंतमपघने शरत्कालेर्कमिव तेजोभिरवनतमूर्द्धमधश्चाश्षोदिशश्चोद्भासयमानं हयहर्त्तारं कपिलर्षिमपश्यन्"
        }
      }
    },
    {
      "ref": "4.4.21",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततश्चोद्यतायुधा दुरात्मानोऽयमस्मदपकारी यज्ञविघ्नकारी हन्यतां हयहर्त्ता हन्यतामित्यवोचन्नभ्यधावंश्च"
        }
      }
    },
    {
      "ref": "4.4.22",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततस्तेनापि भगवता किंचिदीषत्परिवर्त्तितलोचनेनावलोकितास्स्वशरीरसमुत्थेनाऽग्निना-दह्यमाना विनेशुः"
        }
      }
    },
    {
      "ref": "4.4.23",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "सगरोप्यवगम्याश्वानुसारि तत्पुत्रबलमश्षॐ परमर्षिणा कपिलेन तेजसा दग्धं ततॐशुमंतमसमंजसपुत्रमश्वानयनाय युयोज"
        }
      }
    },
    {
      "ref": "4.4.24",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "स तु सगरतनयखातमार्गेण कपिलमुपगम्य भक्तिनम्रस्तदा तृष्टाव"
        }
      }
    },
    {
      "ref": "4.4.25",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अथैनं भगवानाह"
        }
      }
    },
    {
      "ref": "4.4.26",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "गच्छैनं पितामहायाश्वं प्रापय वरं वृणीष्व च पुत्रक पौत्राश्च ते स्वर्गाद्गंगां भुवमानेष्यन्त इति"
        }
      }
    },
    {
      "ref": "4.4.27",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अथांशुमानपि स्वर्यातानां ब्रह्मदंडहतानामस्मत्पितॄणामस्वर्गयोग्यानां स्वर्गप्राप्तिकरं वरमस्माकं प्रयच्छेति प्रत्याह"
        }
      }
    },
    {
      "ref": "4.4.28",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तदाकर्ण्य तं च भगवानाह उक्तमेवैतन्मयाद्य पौत्रस्ते त्रिदिवाद्गंगां भुवमानयिष्यतीति"
        }
      }
    },
    {
      "ref": "4.4.29",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तदंभसा च संस्पृष्टेष्वस्थिभस्मसु एते च स्वर्गमारोक्ष्यन्ति"
        }
      }
    },
    {
      "ref": "4.4.30",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "भगवद्विष्णुपादांगुष्ठनिर्गतस्य हि जलस्यैतन्माहात्म्यम्"
        }
      }
    },
    {
      "ref": "4.4.31",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "यन्न केवलमभिसंधिपूर्वकं स्नानाद्युपभोगेषूपकारकमनभिसांधितमप्यस्यां प्रेतप्राणस्यास्थिचर्मस्नायुकेशाद्युपस्पृष्टं शरीरजमपि पतितं सद्यश्शरीरिणं स्वर्गं नयतीत्युक्तः प्रणम्य भवगतेऽश्वमादाय पितामहयज्ञमाजगाम्"
        }
      }
    },
    {
      "ref": "4.4.32",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "सगरोप्यश्वमासाद्य तं यज्ञं समापयामास"
        }
      }
    },
    {
      "ref": "4.4.33",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "सागरं चात्मजप्रीत्या पुत्रत्वे कल्पितवान्"
        }
      }
    },
    {
      "ref": "4.4.34",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्यांशुमतो दिलीपः पुत्रोभवत्"
        }
      }
    },
    {
      "ref": "4.4.35",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "दिलीपस्य भगीरथः योऽसौ गंगां स्वर्गादिहानीय भागीरथीसंज्ञां चकार"
        }
      }
    },
    {
      "ref": "4.4.36",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "भगीरथात्सुहोत्रस्सुहोत्राच्छ्रुतः तस्यापि नाभागः ततॐबरीषः तत्पुत्रस्सिंधुद्वीपः सिंधुद्वीपादयुतायुः"
        }
      }
    },
    {
      "ref": "4.4.37",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तत्पुत्रश्च ऋतुपर्णः योऽसौ नलसहायोक्षहृदयज्ञोभूत्"
        }
      }
    },
    {
      "ref": "4.4.38",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ऋतुपर्णपुत्रस्सर्वकामः"
        }
      }
    },
    {
      "ref": "4.4.39",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तत्तनयस्सुदासः"
        }
      }
    },
    {
      "ref": "4.4.40",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "सुदासात्सौदासो मित्र सहनामा"
        }
      }
    },
    {
      "ref": "4.4.41",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "स चाटव्यां मृगयार्थी पर्यटन् व्याघ्रद्वयमपश्यत्"
        }
      }
    },
    {
      "ref": "4.4.42",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ताभ्यां तद्वनमपमृगं कृतं मत्वैकं तयोर्बाणेन जघान"
        }
      }
    },
    {
      "ref": "4.4.43",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "म्रियमाणश्चासावतिभीषणाकृतिरतिकरालवदनो राक्षसोऽभूत्"
        }
      }
    },
    {
      "ref": "4.4.44",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "द्वितीयोपि प्रतिक्रियां ते करिष्यामीत्युक्त्वांतर्धानं जगाम"
        }
      }
    },
    {
      "ref": "4.4.45",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "कालेन गच्छता सौदासो यज्ञमयजत्"
        }
      }
    },
    {
      "ref": "4.4.46",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "परिनिष्ठितयज्ञे आचार्ये वसिष्ठे निष्क्रांते तद्र क्षो वसिष्ठरूपमास्थाय यज्ञावसाने मम नरमांसभोजनं देयमिति तत्संस्क्रियतां क्षणादागमिष्यामीत्युक्त्वा निष्क्रांतः"
        }
      }
    },
    {
      "ref": "4.4.47",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "भूयश्च सूदवेषं कृत्वा राजाज्ञया मानुषं मांसं संस्कृत्य राज्ञे न्यवेदयत् ४७ असावपि हिरण्यपात्रे मांसमादाय वसिष्ठागमनप्रतीक्षकोऽभवत्"
        }
      }
    },
    {
      "ref": "4.4.48",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "आगताय वसिष्ठाय निवेदितवान्"
        }
      }
    },
    {
      "ref": "4.4.49",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "स चाप्यचिंतयदहोस्य राज्ञो दौश्शील्यं येनैतन्मांसमस्माकं प्रयच्छति किमेतद्द्र व्यजातमिति ध्यानपरोभवत्"
        }
      }
    },
    {
      "ref": "4.4.50",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अपश्यच्च तन्मांसंमानुषम्"
        }
      }
    },
    {
      "ref": "4.4.51",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अतः क्रोधकलुषीकृतचेता राजनि सापमुत्ससर्ज"
        }
      }
    },
    {
      "ref": "4.4.52",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "यस्मादभोज्यमेतदस्मद्विधानां तपस्विनामवगच्छन्नपि भवान्मह्यं ददाति तस्मात्तवैवात्र लोलुपता भविष्यतीति"
        }
      }
    },
    {
      "ref": "4.4.53",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अनंतरं च तेनापि भगवतैवाभिहितोस्मीत्युक्ते किं किं मयाभहितमिति मुनिः पुनरपि समाधौ तस्थौ"
        }
      }
    },
    {
      "ref": "4.4.54",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "समाधिविज्ञानावगतार्थश्चानुग्रहं तस्मै चकार नात्यंतिकमेतद्द्वादशाब्दं तव भोजनं भविष्यतीति"
        }
      }
    },
    {
      "ref": "4.4.55",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "असावपि प्रतिगृह्योदकांजलिं मुनिशापप्रदानायोद्यतो भगवन्नयमस्मद्गुरुर्नार्हस्येनं कुलदेवताभूतमाचार्यं शप्तुमिति मदयंत्या स्वपत्न्या प्रसादितस्सस्यांबुदरक्षणार्थं तच्छापांवु नोर्व्यां न चाकाशे चिक्षेप किं तु तेनैव स्वपदौ सिषेच"
        }
      }
    },
    {
      "ref": "4.4.56",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तेन च क्वोधाश्रितेनांबुना दग्धच्छायौ तत्पादौ कल्माषतामुपगतौ ततस्स कल्माषपादसंज्ञामवाप"
        }
      }
    },
    {
      "ref": "4.4.57",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "वसिष्ठशापाच्च षष्ठेषष्ठे काले राक्षसस्वभावमेत्याटव्यां पर्यटन्ननेकशो मानुषानभक्षयत्"
        }
      }
    },
    {
      "ref": "4.4.58",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "एकदा तु कंचिन्मुनिमृतुकाले भार्यासंगतं ददर्श"
        }
      }
    },
    {
      "ref": "4.4.59",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तयोश्च तमतिभीषणं राक्षसस्वरूपमवलोक्य त्रासाद्दंपत्योः प्रधावितयोर्ब्रह्मणं जग्राह"
        }
      }
    },
    {
      "ref": "4.4.60",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततस्सा ब्राह्मणी बहुशस्तमभियाचितवती"
        }
      }
    },
    {
      "ref": "4.4.61",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "प्रसीदेक्ष्वाकुकुलतिलकभूतस्त्वं महाराजो मित्रसहो न राक्षसः"
        }
      }
    },
    {
      "ref": "4.4.62",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "नार्हसि स्त्रीधर्मसुखाभिज्ञो मय्यकृतार्थायामस्मद्भर्त्तारं हंतुमित्येवं बहुप्रकारं तस्यां विलपंत्यां व्याघ्रः पशुमिवाऽरण्येऽभिमतं तं ब्राह्मणमभक्षयत्"
        }
      }
    },
    {
      "ref": "4.4.63",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततश्चातिकोपसमन्विता ब्राह्मणी तं राजानं शशाप"
        }
      }
    },
    {
      "ref": "4.4.64",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "यस्मादेवं मय्यतृषप्तायां त्वयायं मत्पतिर्भक्षितः तस्मात्त्वमपि कामोपभोगप्रवृत्तॐतं प्राप्स्यसीति"
        }
      }
    },
    {
      "ref": "4.4.65",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "शप्त्वा चैव साग्निं प्रविवेश"
        }
      }
    },
    {
      "ref": "4.4.66",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततस्तस्य द्वादशाब्दपर्यये विमुक्तशापस्य स्त्रीविषयाभिलाषिणो मदयंती तं स्मारयामास"
        }
      }
    },
    {
      "ref": "4.4.67",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततः परमसौ स्त्रीभोगं तत्याज"
        }
      }
    },
    {
      "ref": "4.4.68",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "वसिष्ठश्चापुत्रेण राज्ञा पुत्रार्थमभ्यर्थितो मदयंत्यां गर्भाधानं चकार"
        }
      }
    },
    {
      "ref": "4.4.69",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "यदा च सप्तवर्षाण्यसौ गर्भेण जज्ञे ततस्तं गर्भमश्मना सा देवी जघान"
        }
      }
    },
    {
      "ref": "4.4.70",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "पुत्रश्चाजायत"
        }
      }
    },
    {
      "ref": "4.4.71",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्य चाश्मक इत्येव नामाभवत्"
        }
      }
    },
    {
      "ref": "4.4.72",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अश्मस्य मूलको नाम पुत्रोऽभवत्"
        }
      }
    },
    {
      "ref": "4.4.73",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "योसौ निःक्षत्रे क्ष्मातलेस्मिन् क्रियमाणे स्त्रीभिर्विवस्त्राभिः परिवार्य रक्षितः ततस्तं नारीकवचमुदाहरंति"
        }
      }
    },
    {
      "ref": "4.4.74",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "मूलकाद्दशरथस्तस्मादिलिविलस्ततश्च विश्वसहः"
        }
      }
    },
    {
      "ref": "4.4.75",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्माच्च खट्वांगः योसौ देवासुरसंग्रामे देवैरभ्यर्थितोऽसुराञ्जघान"
        }
      }
    },
    {
      "ref": "4.4.76",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "स्वर्गे च कृतप्रियैर्देवैर्वरग्रहणाय चोदितः प्राह"
        }
      }
    },
    {
      "ref": "4.4.77",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "यद्यवश्यं वरो ग्राह्यः तन्ममायुः कथ्यतामिति"
        }
      }
    },
    {
      "ref": "4.4.78",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अनंतरं च तैरुक्तं मुहूर्त्तमेकं प्रमाणं तवायुरित्युक्तोथास्खलितगतिना विमानेन लघिमादिगुणो मर्त्यलोकमागम्येदमाह"
        }
      }
    },
    {
      "ref": "4.4.79",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "यथा न ब्राह्मणेभ्यस्सकाशादात्मापि मे प्रियतरः न च स्वधर्मोल्लंघनं मया कदाचिदप्यनुष्ठितं न च सकलदेवमानुषपशुपक्षिवृक्षादिकेष्वच्युतव्यतिरेकवती दृष्टिर्ममाभूत् तथा तमेवं मुनिजनानुस्मृतं भगवंतमस्खलितगतिः प्रापयेयमित्यश्षोदेवगुरौ भगवत्यनिर्द्देश्यवपुषि सत्तामात्रात्मन्यात्मानं परमात्मनि वासुदेवाख्ये युयोज तत्रैव च लयमवाप"
        }
      }
    },
    {
      "ref": "4.4.80",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अत्रापि श्रूयते श्लोको गीतस्सप्तर्षिभिः पुरा ।\nखट्वांगेन समो नान्यः कश्चिदुर्व्यां भविष्यति"
        }
      }
    },
    {
      "ref": "4.4.81",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "येन स्वर्गादिहागम्य मुहूर्त्तं प्राप्य जीवितम् ।\nत्रयोतिसंधिता लोका बुद्ध्या सत्येन चैव हि"
        }
      }
    },
    {
      "ref": "4.4.82",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "खट्वांगाद्दीर्घबाहुः पुत्रोऽभवत्"
        }
      }
    },
    {
      "ref": "4.4.83",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततो रघुरभवत्"
        }
      }
    },
    {
      "ref": "4.4.84",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्मादप्यजः"
        }
      }
    },
    {
      "ref": "4.4.85",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अजाद्दशरथः"
        }
      }
    },
    {
      "ref": "4.4.86",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्यापि भगवानब्जनाभो जगतः स्थित्यर्थमात्मांश्नो रामलक्ष्मणभरतशत्रुघ्नरूपेण चतुर्द्धा पुत्रत्वमायासीत्"
        }
      }
    },
    {
      "ref": "4.4.87",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "रामोपि बाल एव विश्वमित्रयागरक्षणाय गच्छंस्ताटकां जघान"
        }
      }
    },
    {
      "ref": "4.4.88",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "यज्ञे च मारीचमिषुवाताहतं समुद्रे चिक्षेप"
        }
      }
    },
    {
      "ref": "4.4.89",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "सुबाहुप्रमुखांश्च क्षयमनयत्"
        }
      }
    },
    {
      "ref": "4.4.90",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "दर्शनमात्रेणाहल्यामपापां चकार"
        }
      }
    },
    {
      "ref": "4.4.91",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "जनकगृहे च माहेश्वरं चापमनायासेन बभंज"
        }
      }
    },
    {
      "ref": "4.4.92",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "सीतामयोनिजां जनकराजतनयां वीर्यशुल्कां लेभे"
        }
      }
    },
    {
      "ref": "4.4.93",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "सकलक्षत्त्रियक्षयकारिणमश्षोहैहयकुलधूमकेतुभूतं च परशुराममपास्तवीर्यबलावलेपं चकार"
        }
      }
    },
    {
      "ref": "4.4.94",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "पितृवचनाच्चागणितराज्याभिलाषो भ्रातृभार्यासमेतो वनं प्रविवेश"
        }
      }
    },
    {
      "ref": "4.4.95",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "विराधखरदूषणादीन् कबंधवालिनौ च निजघान"
        }
      }
    },
    {
      "ref": "4.4.96",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "बद्धा चांभोनिधिमसेषराक्षसकुलक्षयं कृत्वा दशाननापहृतां भार्यां तद्वधादपहृतकलंकामप्यनलप्रवेशशुद्धामश्षोदेवसंघैस्तूयमानशीलां जनकराजकन्यामयोध्यामानिन्ये"
        }
      }
    },
    {
      "ref": "4.4.97",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततश्चाभिषेकमंगलं मैत्रेय वर्षशतेनापि वक्तुं न शक्यते संक्षेपेण श्रूयताम्"
        }
      }
    },
    {
      "ref": "4.4.98",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "लक्ष्मणभरतशत्रुघ्नविभीषणसुग्रीवांगदजाम्बवद्धनुमत्प्रभृतिभिस्समु-त्फुल्लवदनैश्छत्रचामरादियुतैः सेव्यमानो दाशरथिर्ब्रह्मेंयमनिरृतिवरुणवायुकुबेरेशानप्रभृतिभिस्सर्वामरैर्वसि-ष्ठवामदेववाल्मीकिमार्कण्डेयविश्वामित्रभरद्वाजागस्त्यप्रभृतिभिर्मु-निवरैः ऋग्यजुस्सामाथर्वैस्संस्तूयमानो नृत्यगीतवाद्याद्यखिललोकमंगलवाद्यैर्वीणावेणुमृदंगभेरीपटहशंखकाहलगोमुखप्रभृतिभिस्सुना-दैस्समस्तभूभृतां मध्ये सकललोकरक्षार्थं यथोचितमभिषिक्तो दाशरथिः कोसलेंद्रो रघुकुलतिलको जानकीप्रियो भ्रातृत्रयप्रियस्सिंहासनगत एकादसाब्दसहस्रं राज्यमकरोत्"
        }
      }
    },
    {
      "ref": "4.4.99",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "भरतोपि गंधर्वविषयसाधनाय गच्छन् संग्रामे गंधर्वकोटीस्तिस्रो जघान"
        }
      }
    },
    {
      "ref": "4.4.100",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "शत्रुघ्नेनाप्यमितबलपराक्रमो मधुपुत्रो लवणो नाम राक्षसो निहतो मथुरा च निवेशिता"
        }
      }
    },
    {
      "ref": "4.4.101",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "इत्येवमाद्यतिबलपराक्रमविक्रमणैरतिदुष्टसंहारिणोश्षोस्य जगतो निष्पादितस्थितयो रामलक्ष्मणभरतशत्रुघ्नाः पुनरपि दिवमारूढाः"
        }
      }
    },
    {
      "ref": "4.4.102",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "येऽपि तेषु भगवदंश्ष्वोनुरागिणः कोसलनगरजानपदास्तेपि तन्मनसस्तत्सालोक्यतामवापुः"
        }
      }
    },
    {
      "ref": "4.4.103",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अतिदुष्टसंहारिणो रामस्य कुशलवौ द्वौ पुत्रौ लक्ष्मणस्यांगदचंद्र केतू तक्षपुष्कलौ भरतस्य सुबाहुशूरसेनौ शत्रुघ्नस्य"
        }
      }
    },
    {
      "ref": "4.4.104",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "कुशस्यातिथिरतिथेरपि निषधः पुत्रोऽभूत्"
        }
      }
    },
    {
      "ref": "4.4.105",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "निषधस्याप्यनलस्तस्मादपि नभाः नभसः पुंडरीकस्तत्तनयः क्षेमधन्वा तस्य च देवानीकस्तस्याप्यहीनकोऽहीनकस्यापि रुरुस्तस्य च पारियात्रकः पारियात्राद्देवलो देवलाद्वच्चलः तस्याप्युत्कः उत्काच्च वज्रनाभस्तस्माच्छंखणस्तमाद्युषिताश्वस्ततश्च विश्वसहो जज्ञे"
        }
      }
    },
    {
      "ref": "4.4.106",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्माद्धिरण्यनाभः यो महायोगीस्वराज्जैमिनेश्शिष्याद्याज्ञवल्क्याद्योगमवाय"
        }
      }
    },
    {
      "ref": "4.4.107",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "हिरण्यनाभस्य पुत्रः पुष्यस्तस्माद् ध्रुवसंधिस्ततस्सुदर्शनस्तस्मादग्निवर्णस्ततश्शीघ्रगस्तस्मादपि मरुः पुत्रोऽभवत्"
        }
      }
    },
    {
      "ref": "4.4.108",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "योसौ योगमास्थायाद्यापि कलापग्राममश्रित्य तिष्ठति"
        }
      }
    },
    {
      "ref": "4.4.109",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "आगामियुगे सूर्यवंशक्षत्रव्रत आवर्त्तयिता भविष्यति"
        }
      }
    },
    {
      "ref": "4.4.110",
