{
  "kind": "grantha-part",
  "schema_version": "1.3.0",
  "grantha_id": "vishnu-purana",
  "edition_id": "vishnu-purana",
  "part_num": 78,
  "passages": [
    {
      "ref": "4.22.1",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अतश्चेक्ष्वाकवो भविष्याः पार्थिवाः कथ्यन्ते"
        }
      },
      "speaker": "श्रीपराशर उवाच"
    },
    {
      "ref": "4.22.2",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "बृहद्बलस्य पुत्रो बृहत्क्षणः"
        }
      }
    },
    {
      "ref": "4.22.3",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्मादुरुक्षयस्तस्माच्च वत्सव्यूहस्ततश्च प्रतिव्योमस्तस्मादपि दिवाकरः"
        }
      }
    },
    {
      "ref": "4.22.4",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्मात्सहदेवः सहदेवाद्बृहदश्वस्तत्सूनुर्भानुरथस्तस्य च प्रतीताश्वस्तस्यापि सुप्रतीकस्ततश्च मरुदेवस्ततः सुनक्षत्रस्तमात्किन्नरः"
        }
      }
    },
    {
      "ref": "4.22.5",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "किन्नरादन्तरिक्षस्तस्मात्सुपर्णस्ततश्चामित्रजित्"
        }
      }
    },
    {
      "ref": "4.22.6",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततश्च बृहद्भाजस्तस्यापि धर्मी धर्मीणः कृतञ्जयः"
        }
      }
    },
    {
      "ref": "4.22.7",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "कृतञ्जयाद्रणञ्जयः"
        }
      }
    },
    {
      "ref": "4.22.8",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "रणञ्जयात्संजयस्तस्माच्छाक्यश्छाक्याच्छुद्धोदनस्तस्माद्राहुलस्ततः प्रसेनजित्"
        }
      }
    },
    {
      "ref": "4.22.9",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततश्च क्षुद्रकस्ततश्चज कुण्डकस्तस्मादपि सुरथः"
        }
      }
    },
    {
      "ref": "4.22.10",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तत्पुत्रश्च सुमित्रः"
        }
      }
    },
    {
      "ref": "4.22.11",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "इत्येते चेक्ष्वाकवो बृहद्बलान्वयाः"
        }
      }
    },
    {
      "ref": "4.22.12",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अत्रानुवंशश्लोकः"
        }
      }
    },
    {
      "ref": "4.22.13",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "इक्ष्वाकूणामयं वंशःसुमित्रान्तो भविष्यति ।\nयतस्तं प्राप्य राजानं संस्थां प्राप्स्यति वै कलौ"
        }
      }
    },
    {
      "ref": "4.22.14",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "इति श्रीमहाविष्णुपुराणे चतुर्थांशे द्वाविंशोऽध्यायः (२२)"
        }
      }
    }
  ]
}