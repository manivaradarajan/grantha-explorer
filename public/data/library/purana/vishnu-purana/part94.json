{
  "kind": "grantha-part",
  "schema_version": "1.2.0",
  "grantha_id": "vishnu-purana",
  "edition_id": "vishnu-purana",
  "part_num": 94,
  "passages": [
    {
      "ref": "5.14.1",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "प्रदोषाग्रे कदाचित्तु रासासक्ते जनार्दने।\nत्रासयन्समदो गोष्ठमरिष्टस्समुपागमत्"
        }
      },
      "speaker": "श्रीपराशर उवाच"
    },
    {
      "ref": "5.14.2",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "स तोयतोयदच्छायस्तीक्ष्णशृंगोर्कलोचनः।\nखुराग्रपातैरत्यर्थं दारयन्धरणीतलम्"
        }
      }
    },
    {
      "ref": "5.14.3",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "लेलिहानस्सनिष्पेषं जिह्वयोष्ठौ पुनःपुनः।\nसंरंभाविद्धलांगूलः कठिनस्कंधबंधनः"
        }
      }
    },
    {
      "ref": "5.14.4",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "उदग्रककुदाभोगप्रमाणो दुरतिक्रमः।\nविण्मूत्रलिप्तपृष्ठांगो गवामुद्वेगकारकः"
        }
      }
    },
    {
      "ref": "5.14.5",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "प्रलंबकंठोऽतिमुखस्तरुखातांकिताननः।\nपातयन्स गवां गर्भान्दैत्यो वृषभरूपधृक्"
        }
      }
    },
    {
      "ref": "5.14.6",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "सूदयंस्तापसानुग्रो वनानटति यस्सदा"
        }
      }
    },
    {
      "ref": "5.14.7",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततस्तमतिघोराक्षमवेक्ष्यातिभयातुराः।\nगोपा गोपस्त्रियश्चैव कृष्णकृष्णेति चुक्रुशुः"
        }
      }
    },
    {
      "ref": "5.14.8",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "सिंहनादं ततश्चक्रे तलशब्दं च केशवः।\nतच्छब्दश्रवणाच्चाऽसौ दामोदरमुपाययौ"
        }
      }
    },
    {
      "ref": "5.14.9",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अग्रन्यस्तविषाणाग्रः कृष्णकुक्षिकृतेक्षणः ।\nअभ्यधावत दुष्टात्मा कृष्णं वृषभदानवः"
        }
      }
    },
    {
      "ref": "5.14.10",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "आयांतं दैत्यवृषभं दृष्ट्वा कृष्णो महाबलः।\nन चचाल तदा स्थानादवज्ञास्मितलीलया"
        }
      }
    },
    {
      "ref": "5.14.11",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "आसन्नं चैव जग्राह ग्राहवन्मधुसूदनः।\nजघान जानुना कुक्षौ विषाणग्रहणाचलम्"
        }
      }
    },
    {
      "ref": "5.14.12",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्य दर्पबलं भंक्त्वा गृहीतस्य विषाणयोः।\nअपीडयदरिष्टस्य कंठं क्लिन्नमिवांबरम्"
        }
      }
    },
    {
      "ref": "5.14.13",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "उत्पाट्य शृंगमेकं तु तेनैवाताडयत्ततः।\nममार स महादैत्यो मुखाच्छोणितमुद्वमन्"
        }
      }
    },
    {
      "ref": "5.14.14",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तुष्टुवुर्निहते तस्मिन्दैत्ये गोपा जनार्दनम् ।\nजंभे हते सहस्राक्षं पुरा देवगणा यथा"
        }
      }
    }
  ]
}