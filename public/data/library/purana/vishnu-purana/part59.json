{
  "kind": "grantha-part",
  "schema_version": "1.3.0",
  "grantha_id": "vishnu-purana",
  "edition_id": "vishnu-purana",
  "part_num": 59,
  "passages": [
    {
      "ref": "4.3.1",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अतश्च मांधातुः पुत्रसंततिरभिधीयते"
        }
      }
    },
    {
      "ref": "4.3.2",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अंबरीषस्य मांधातृतनयस्य युवनाश्वः पुत्रोऽभूत्"
        }
      }
    },
    {
      "ref": "4.3.3",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्माद्धारीतः यतोंगिरसो हारीता"
        }
      }
    },
    {
      "ref": "4.3.4",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "रसातले मौनेया नाम गंधर्वा बभूवुष्षट्कोटिसंख्यातास्तैरशेषाणि नागकुलान्यपहृतप्रधानरत्नाधिपत्यान्यक्रियंत"
        }
      }
    },
    {
      "ref": "4.3.5",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तैश्च गंधर्ववीर्यावभूतैरुरगेश्वरैस्तूयमानो भगवानशेषदेवेश आस्ते तच्छ्रवणोन्मीलितोन्निद्रपुंडरीकनयनो जलशयनो निद्रावसानप्रबुद्धः प्रणिपत्याभिहितः । भगवन्नस्माकमेतेभ्यो गंधर्वेभ्यो भयमुत्पन्नं कथमुपशममेष्यतीति"
        }
      }
    },
    {
      "ref": "4.3.6",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "आह च भगवाननादिनिधनपुरुषोत्तमो योसौ यौवनाश्वस्य मांधातुः पुरुकुत्सनामा पुत्रस्तमहमनुप्रविश्य तानशेषान् दुष्टगंधर्वानुपशमं नयिष्यामीति"
        }
      }
    },
    {
      "ref": "4.3.7",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तदाकर्ण्य भगवते जलशायिने कृतप्रणामाः पुनर्नागलोकमागताः पन्नगाधिपतयो नर्मदां च पुरुकुत्सानयनाय चोदयामासुः"
        }
      }
    },
    {
      "ref": "4.3.8",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "सा चैनं रसातलं नीतवती"
        }
      }
    },
    {
      "ref": "4.3.9",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "रसातलगतश्चासौ भगवत्तेजसाप्यायितात्मवीर्य्यस्सकलगंधर्वान्निजघान"
        }
      }
    },
    {
      "ref": "4.3.10",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "पुनश्च स्वपुरमाजगाम"
        }
      }
    },
    {
      "ref": "4.3.11",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "सकलपन्नगाधिपतयश्च नर्मदायै वरं ददुः ।\nयत्तेनुस्मरणसमवेतं नामग्रहणं करिष्यति न तस्य सर्पविषभयं भविष्यतीति"
        }
      }
    },
    {
      "ref": "4.3.12",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अत्र च श्लोकः"
        }
      }
    },
    {
      "ref": "4.3.13",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "नर्मदायै नमः प्रातर्नर्मदायै नमो निशि ।\nनमोस्तु नर्मदे तुभ्यं त्राहि मां विषसर्पतः"
        }
      }
    },
    {
      "ref": "4.3.14",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "इत्युच्चार्याहर्निशमंधकारप्रवेशे वा सर्पैर्न दश्यते न चापि कृतानुस्मरणभुजो विषमपि भुक्तमुपघाताय भवति"
        }
      }
    },
    {
      "ref": "4.3.15",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "पुरुकुत्साय संततिविच्छेदो न भविष्यतीत्युरगपतयो वरं ददुः"
        }
      }
    },
    {
      "ref": "4.3.16",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "पुरुकुत्सो नर्मदायां त्रसद्दस्युमजीजनत्"
        }
      }
    },
    {
      "ref": "4.3.17",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "त्रसद्दस्युतस्संभूतोऽनरण्यः यं रावणोदिग्विजये जघान"
        }
      }
    },
    {
      "ref": "4.3.18",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अनरण्यस्य पृषदश्वः पृषदश्वस्य हर्यश्वः पुत्रोऽभवत्"
        }
      }
    },
    {
      "ref": "4.3.19",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्य च हस्तः पुत्रोऽभवत्"
        }
      }
    },
    {
      "ref": "4.3.20",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततश्च सुमनास्तस्यापि त्रिधन्वा त्रिधन्वनस्त्रय्यारुणिः"
        }
      }
    },
    {
      "ref": "4.3.21",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "त्रय्यारुणेस्सत्यव्रतः योऽसौ त्रिशंकुसंज्ञामवाप"
        }
      }
    },
    {
      "ref": "4.3.22",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "स चंडालतामुपगतश्च"
        }
      }
    },
    {
      "ref": "4.3.23",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "द्वादशवर्षिक्यामनावृष्ट्यां विश्वामित्रकलत्रापत्यपोषणार्थं चंडालप्रतिग्रहपरिहरणाय च जाह्नवीतीरन्यग्रोधे मृगमांसमनुदिनं बबंध"
        }
      }
    },
    {
      "ref": "4.3.24",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "स तु परितुष्टेन विश्वामित्रेण सशरीरस्स्वर्गमारोपितः"
        }
      }
    },
    {
      "ref": "4.3.25",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "त्रिशंकोर्हरिश्चंद्र स्तस्माच्च रोहिताश्वस्ततश्च हरितो हरितस्य चंचुश्चंचोर्विजयवसुदेवौ रुरुको विजयाद्रु कस्य वृकः"
        }
      }
    },
    {
      "ref": "4.3.26",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततो वृकस्य बाहुः योऽसौ हैहयतालजंघादिभिः पराजितॐतर्वत्न्या महिष्या सह वनं प्रविवेश"
        }
      }
    },
    {
      "ref": "4.3.27",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्याश्चा सपत्न्या गर्भस्तंभनाय गरो दत्तः"
        }
      }
    },
    {
      "ref": "4.3.28",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तेनास्य गर्भस्सप्तवर्षाणि जठर एव तस्थौ"
        }
      }
    },
    {
      "ref": "4.3.29",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "स च बाहुर्वृद्धभावादौर्वाश्रमममीपे ममार"
        }
      }
    },
    {
      "ref": "4.3.30",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "सा तस्य भार्या चितां कृत्वा तमारोप्यानुमरणकृतनिश्चयाऽभूत्"
        }
      }
    },
    {
      "ref": "4.3.31",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अथैतामतीतानागतवर्त्तमानकालत्रयवेदी भगवानौर्वस्स्वाश्रमान्निर्गत्याब्रवीत्"
        }
      }
    },
    {
      "ref": "4.3.32",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अलमलमनेनासद्ग्राहेणाखिलभूमं डलपतिरतिवीर्यपराक्रमो नैकयज्ञकृदरातिपक्षक्षयकर्त्ता तवोदरे चक्रवर्त्ती तिष्ठति"
        }
      }
    },
    {
      "ref": "4.3.33",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "नैवमतिसाहसाध्यवसायिनी भवती भवेत्युक्ता सा तस्मादनुमरणनिर्बंधाद्विरराम"
        }
      }
    },
    {
      "ref": "4.3.34",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तेनैव च भगवता स्वाश्रममानीता"
        }
      }
    },
    {
      "ref": "4.3.35",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तत्र कतिपयदिनाभ्यंतरे च सहैव तेन गरेणातितेजस्वी बालको जज्ञे"
        }
      }
    },
    {
      "ref": "4.3.36",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्यौर्वो जातकर्मादिक्रिया निष्पाद्य सगर इति नाम चकार"
        }
      }
    },
    {
      "ref": "4.3.37",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "कृतोपनयनं चैनमौर्वो वेदशास्त्राण्यस्त्रं चाग्नेयं भार्गवाख्यमध्यापयामास"
        }
      }
    },
    {
      "ref": "4.3.38",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "उत्पन्नबुद्धिश्च मातरमब्रवीत्"
        }
      }
    },
    {
      "ref": "4.3.39",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अंब कथयात्र वयं क्व तातोस्माकमित्येवमादिपृच्छंतं माता सर्वमेवावोचत्"
        }
      }
    },
    {
      "ref": "4.3.40",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततश्च पितृराज्यापहरणादमर्षितो हैहयतालजंघादिवधाय प्रतिज्ञामकरोत्"
        }
      }
    },
    {
      "ref": "4.3.41",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "प्रायशश्च हैहयतालजंघाञ्जघान"
        }
      }
    },
    {
      "ref": "4.3.42",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "शकयवनकांभोजपारदपप्लवाः हन्यमानास्तत्कुलगुरुं वसिष्ठं शरणं जग्मुः"
        }
      }
    },
    {
      "ref": "4.3.43",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अथैनान्वसिष्ठो जीवन्मृतकान् कृत्वा सगरमाह"
        }
      }
    },
    {
      "ref": "4.3.44",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "वत्सालमेभिर्जीवन्मृतकैरनुमृतैः"
        }
      }
    },
    {
      "ref": "4.3.45",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "एते च मयैव त्वत्प्रतिज्ञापरिपालनाय निजधर्मद्विजसंगपरित्यागं कारिताः"
        }
      }
    },
    {
      "ref": "4.3.46",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तथेति तद्गुरुवचनमभिनंद्य तेषां वेषान्यत्वमकारयत्"
        }
      }
    },
    {
      "ref": "4.3.47",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "यवनान्मुंडितशिरसोर्द्धमुंडिताञ्च्छकान् प्रलंबकेशान् पारदान् पप्लवाञ्श्मश्रुधरान् निस्स्वाध्यायवषट्कारानेतानन्यांश्च क्षत्रियांश्चकार"
        }
      }
    },
    {
      "ref": "4.3.48",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "एते चात्मधर्मपरित्यागाद्ब्राह्मणैः परित्यक्ता म्लेच्छतां ययुः"
        }
      }
    },
    {
      "ref": "4.3.49",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "सगरोपि स्वमधिष्ठानमागम्य अस्खलितचक्रस्सप्तद्वीपवतीमिमामुर्वीं प्रशशास"
        }
      }
    }
  ]
}