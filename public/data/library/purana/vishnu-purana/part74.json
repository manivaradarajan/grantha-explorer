{
  "kind": "grantha-part",
  "schema_version": "1.2.0",
  "grantha_id": "vishnu-purana",
  "edition_id": "vishnu-purana",
  "part_num": 74,
  "passages": [
    {
      "ref": "4.18.1",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ययातेश्चातुर्थपुत्रस्यानोःसभानलचक्षुः परमेषुसंज्ञास्त्रयः पुत्रा बभूवुः"
        }
      },
      "speaker": "श्रीपराशर उवाच"
    },
    {
      "ref": "4.18.2",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "सभानलपुत्रः कालानलः"
        }
      }
    },
    {
      "ref": "4.18.3",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "कालानलात्सृंजयः"
        }
      }
    },
    {
      "ref": "4.18.4",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "सृंजयात्पुरञ्जयः"
        }
      }
    },
    {
      "ref": "4.18.5",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "पुरञ्जयाज्जनमेजयः"
        }
      }
    },
    {
      "ref": "4.18.6",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्मान्महाशालः"
        }
      }
    },
    {
      "ref": "4.18.7",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्माच्च महामनाः"
        }
      }
    },
    {
      "ref": "4.18.8",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्मादुशीनरतितीक्षू द्वौ पुत्रावुत्पन्नौ"
        }
      }
    },
    {
      "ref": "4.18.9",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "उशीनरस्यापि शिबिनृगनवकृमि वर्माख्याः पञ्च पुत्रा बभूवुः"
        }
      }
    },
    {
      "ref": "4.18.10",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "पृषदर्भसुवीरकेकयमद्रकाश्चत्वारशिशबिपुत्राः"
        }
      }
    },
    {
      "ref": "4.18.11",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तितीक्षोरपि रुशद्रथः पुत्रोऽभूत्"
        }
      }
    },
    {
      "ref": "4.18.12",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्यापि हेमः हेमस्यापि सुतपाः सुतपसश्च बलिः"
        }
      }
    },
    {
      "ref": "4.18.13",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "यस्य क्षेत्रे दीर्घतमसांगवङ्गकलिङ्गसुह्यपौण्ड्राख्यं वालेयं क्षत्रमजन्यत"
        }
      }
    },
    {
      "ref": "4.18.14",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तन्नामसंतसतिसंज्ञाश्च पञ्चविषयाः बभूवुः"
        }
      }
    },
    {
      "ref": "4.18.15",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अङ्गादनपानस्ततो दिविरथस्तस्माद्धर्मरथः"
        }
      }
    },
    {
      "ref": "4.18.16",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततश्चित्ररथः रोमपादसंज्ञः"
        }
      }
    },
    {
      "ref": "4.18.17",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "यस्य दशरथो मित्रं जज्ञे"
        }
      }
    },
    {
      "ref": "4.18.18",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "यस्याजपुत्रो दशरथः शान्तां नाम कन्यामनपत्यस्यदुहितृत्वे युयोज"
        }
      }
    },
    {
      "ref": "4.18.19",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "रोमपादाच्चतुरङ्गः तस्मात्पृथुलाक्षः"
        }
      }
    },
    {
      "ref": "4.18.20",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "ततश्चंपः यश्चंपां निवेशायामास"
        }
      }
    },
    {
      "ref": "4.18.21",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "चंपस्य हर्यङ्गो नामात्मजोऽभूत्"
        }
      }
    },
    {
      "ref": "4.18.22",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "हर्यङ्गाद्भद्ररथः भद्ररथाद्बृहद्रथः बृहद्रथाद्बृहत्कर्मा बृहत्कर्मणश्च वृहद्भानुस्तस्माच्च बृहन्मनाः बृहन्मनसो जयद्रथः"
        }
      }
    },
    {
      "ref": "4.18.23",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "जयद्रथो ब्रहमक्षत्रान्तरालसंभूत्यां पत्न्यां विजयं नाम पुत्रमजीजनत्"
        }
      }
    },
    {
      "ref": "4.18.24",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "विजयश्च धृतिं पुत्रमवाप"
        }
      }
    },
    {
      "ref": "4.18.25",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "तस्यापि धृतव्रतः पुत्रोऽभूत्"
        }
      }
    },
    {
      "ref": "4.18.26",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "धृतव्रतात्सत्यकर्मा"
        }
      }
    },
    {
      "ref": "4.18.27",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "सत्यकर्मणस्त्वतिरथः"
        }
      }
    },
    {
      "ref": "4.18.28",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "यो गङ्गाङ्गतो मञ्जूषागतं पृथापविद्धं कर्णं पुत्रमवाप"
        }
      }
    },
    {
      "ref": "4.18.29",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "कर्णाद्वृषसेनः इत्येतदन्ता अङ्गवंश्याः"
        }
      }
    },
    {
      "ref": "4.18.30",
      "passage_type": "main",
      "content": {
        "sanskrit": {
          "devanagari": "अतश्च पुरुवंशं श्रोतुमर्हसि"
        }
      }
    }
  ]
}